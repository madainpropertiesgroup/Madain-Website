---
import '../styles/global.css';

interface Props {
  title: string;
  active: 'meeting' | 'nominees' | 'attendance' | 'documents';
}

const { title, active } = Astro.props;
const tabActive = active === 'nominees' ? 'meeting' : active;

const SITE = 'https://madain.com';
const tabs = [
  { key: 'meeting', label: 'الجمعية العمومية', href: '/general-assembly-2026/' },
  { key: 'attendance', label: 'تعليمات الحضور والتصويت', href: '/general-assembly-2026/attendance-voting/' },
  { key: 'documents', label: 'الدعوة والمستندات', href: '/general-assembly-2026/documents/' },
];

const quickLinks = [
  { label: 'الرئيسية', href: '/' },
  { label: 'من نحن', href: `${SITE}/about-us/` },
  { label: 'المشاريع', href: `${SITE}/projects/` },
  { label: 'تواصل معنا', href: `${SITE}/contact-us/` },
];

const socials = [
  {
    label: 'LinkedIn',
    href: "https://www.linkedin.com/company/mada%27in-properties",
    path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05a4.2 4.2 0 0 1 3.77-2c4 0 4.75 2.5 4.75 5.9V21h-4v-5.5c0-1.3 0-3-1.9-3s-2.2 1.45-2.2 2.9V21h-4z',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/madainofficial/',
    path: 'M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 1.8.25 2.2.42.6.22 1 .48 1.4.9.42.4.68.8.9 1.4.17.4.36 1 .42 2.2.07 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.25 1.8-.42 2.2-.22.6-.48 1-.9 1.4-.4.42-.8.68-1.4.9-.4.17-1 .36-2.2.42-1.3.07-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-1.8-.25-2.2-.42-.6-.22-1-.48-1.4-.9-.42-.4-.68-.8-.9-1.4-.17-.4-.36-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.25-1.8.42-2.2.22-.6.48-1 .9-1.4.4-.42.8-.68 1.4-.9.4-.17 1-.36 2.2-.42C8.4 2.2 8.8 2.2 12 2.2zm0 3.05a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5zm0 11.13a4.38 4.38 0 1 1 0-8.76 4.38 4.38 0 0 1 0 8.76zm6.95-11.4a1.58 1.58 0 1 1-3.15 0 1.58 1.58 0 0 1 3.15 0z',
  },
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/madainofficial/',
    path: 'M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H16.7V3.6c-.3-.04-1.3-.13-2.45-.13-2.44 0-4.1 1.49-4.1 4.22V9.9H7.4V13h2.75v8z',
  },
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/@madainofficial',
    path: 'M21.6 7.2a2.5 2.5 0 0 0-1.75-1.77C18.3 5 12 5 12 5s-6.3 0-7.85.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.75 1.77C5.7 19 12 19 12 19s6.3 0 7.85-.43a2.5 2.5 0 0 0 1.75-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3z',
  },
];

const navItems = [
  { label: 'الرئيسية', href: '/' },
  { label: 'من نحن', href: `${SITE}/about-us/` },
  { label: 'المشاريع', href: `${SITE}/projects/` },
  { label: 'المستثمرون', href: `${SITE}/investment/` },
  { label: 'العلاقات الإعلامية', href: `${SITE}/media-center/` },
  { label: 'تواصل معنا', href: `${SITE}/contact-us/` },
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="معلومات الجمعية العمومية لشركة مدائن العقارية ش.م.خ — الأربعاء 02 سبتمبر 2026، الساعة 10:00 صباحاً."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[#FBF8F1] font-arabic text-[15px] leading-relaxed text-madain-tundora">
    <!-- Top gold bar -->
    <div class="w-full bg-[#8A7A2E] text-white" dir="ltr">
      <div class="mx-auto flex max-w-container flex-col items-center justify-between gap-2 px-6 py-2.5 sm:flex-row">
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-1">
          <a href="tel:+971800370" class="inline-flex items-center gap-2 text-[13px] font-light transition hover:text-madain-straw">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            +971 800 370
          </a>
          <a href="mailto:sales@madain.ae" class="inline-flex items-center gap-2 text-[13px] font-light transition hover:text-madain-straw">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
            sales@madain.ae
          </a>
        </div>
        <a
          href={`${SITE}/book-appointment/`}
          class="rounded-sm border border-white/70 px-5 py-1.5 text-[12.5px] font-medium text-white transition hover:bg-white/10"
        >
          احجز موعداً
        </a>
      </div>
    </div>

    <!-- Wordmark + nav -->
    <header class="w-full border-b border-madain-gallery bg-white">
      <div class="mx-auto flex max-w-container flex-col items-center justify-between gap-4 px-6 py-4 md:flex-row">
        <a href="/" class="flex items-center">
          <img src="/images/logo.png" alt="مدائن" class="h-9 w-auto md:h-10" />
        </a>
        <nav class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2">
          {navItems.map((item) => (
            <a href={item.href} class="text-[14px] font-normal text-[#0B1B3B] transition hover:text-madain-gold">
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <!-- Assembly section tabs -->
    <nav class="w-full border-b border-madain-gallery bg-[#FBF9F4]">
      <div class="mx-auto flex max-w-container flex-wrap justify-center gap-x-2 gap-y-1 px-6">
        {tabs.map((tab) => (
          <a
            href={tab.href}
            aria-current={tabActive === tab.key ? 'page' : undefined}
            class:list={[
              'border-b-2 px-4 py-3 text-[14px] transition',
              tabActive === tab.key
                ? 'border-madain-gold font-bold text-madain-goldDark'
                : 'border-transparent text-madain-tundora hover:text-madain-gold',
            ]}
          >
            {tab.label}
          </a>
        ))}
      </div>
    </nav>

    <main class="mx-auto max-w-[980px] px-5 py-10 md:px-6 md:py-12">
      <slot />
    </main>

    <footer class="mt-4 w-full bg-[#0B2545] text-white">
      <div class="mx-auto flex max-w-container flex-col items-center justify-center gap-6 px-6 py-5 sm:flex-row sm:gap-14">
        <a href="https://wa.me/971800370" class="flex items-center gap-3 transition hover:text-madain-straw">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#25A366]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 0 0-8.6 15.05L2 22l5.1-1.33A10 10 0 1 0 12 2Zm5.5 14.1c-.23.65-1.34 1.25-1.86 1.29-.5.04-.98.2-3.3-.7-2.78-1.1-4.53-3.94-4.67-4.12-.13-.18-1.11-1.48-1.11-2.83 0-1.34.7-2 .95-2.28.25-.27.54-.34.72-.34h.52c.17 0 .4-.06.62.48.23.55.79 1.9.86 2.04.07.13.11.29.02.47-.09.18-.13.29-.27.44l-.4.47c-.13.13-.27.28-.12.55.15.27.66 1.09 1.42 1.77.98.87 1.8 1.14 2.07 1.27.27.14.42.11.58-.07.15-.18.66-.77.84-1.04.18-.27.35-.22.6-.13.24.09 1.58.74 1.85.88.27.13.45.2.52.31.07.11.07.64-.16 1.29Z"/></svg>
          </span>
          <span class="text-center sm:text-right">
            <span class="block font-inter text-[15px] font-semibold" dir="ltr">+971 800 370</span>
            <span class="block text-[12.5px] text-white/60">واتساب</span>
          </span>
        </a>

        <span class="hidden h-10 w-px bg-white/15 sm:block"></span>

        <a href="tel:+971564777666" class="flex items-center gap-3 transition hover:text-madain-straw">
          <svg class="shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D5C68A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <span class="text-center sm:text-right">
            <span class="block font-inter text-[15px] font-semibold" dir="ltr">+971 56 477 7666</span>
            <span class="block text-[12.5px] text-white/60">اتصال مباشر</span>
          </span>
        </a>

        <span class="hidden h-10 w-px bg-white/15 sm:block"></span>

        <a href="https://www.madaingrp.ae" class="flex items-center gap-3 transition hover:text-madain-straw">
          <svg class="shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D5C68A" stroke-width="1.7" stroke-linecap="round">
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z" />
          </svg>
          <span class="text-center sm:text-right">
            <span class="block font-inter text-[15px] font-semibold" dir="ltr">www.madaingrp.ae</span>
            <span class="block text-[12.5px] text-white/60">الموقع الإلكتروني</span>
          </span>
        </a>
      </div>
    </footer>
  </body>
</html>
