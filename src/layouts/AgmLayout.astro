---
import '../styles/global.css';

interface Props {
  title: string;
  active: 'meeting' | 'attendance' | 'documents';
}

const { title, active } = Astro.props;

const SITE = 'https://madain.com';
const tabs = [
  { key: 'meeting', label: 'موعد ومكان الاجتماع', href: '/general-assembly-2026/' },
  { key: 'attendance', label: 'الحضور والتصويت', href: '/general-assembly-2026/attendance-voting/' },
  { key: 'documents', label: 'المستندات والتواصل', href: '/general-assembly-2026/documents/' },
];

const navItems = [
  { label: 'الرئيسية', href: '/' },
  { label: 'من نحن', href: `${SITE}/about-us/` },
  { label: 'المشاريع', href: `${SITE}/projects/` },
  { label: 'المستثمرون', href: `${SITE}/investment/` },
  { label: 'العلاقات الإعلامية', href: `${SITE}/media-center/` },
  { label: 'تواصل معنا', href: `${SITE}/contact-us/` },
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="معلومات الجمعية العمومية لشركة مدائن العقارية ش.م.خ — الأربعاء 02 سبتمبر 2026، الساعة 10:00 صباحاً."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="bg-white font-arabic text-[15px] leading-relaxed text-madain-tundora">
    <!-- Top gold bar -->
    <div class="w-full bg-[#8A7A2E] text-white" dir="ltr">
      <div class="mx-auto flex max-w-container flex-col items-center justify-between gap-2 px-6 py-2.5 sm:flex-row">
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-1">
          <a href="tel:+971800370" class="inline-flex items-center gap-2 text-[13px] font-light transition hover:text-madain-straw">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            +971 800 370
          </a>
          <a href="mailto:sales@madain.ae" class="inline-flex items-center gap-2 text-[13px] font-light transition hover:text-madain-straw">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
            sales@madain.ae
          </a>
        </div>
        <a
          href={`${SITE}/book-appointment/`}
          class="bg-[#9C8A3A] px-6 py-2 text-[11px] font-light uppercase tracking-[0.15em] text-white transition hover:bg-[#78682A]"
        >
          Book an Appointment
        </a>
      </div>
    </div>

    <!-- Wordmark + nav -->
    <header class="w-full border-b border-madain-gallery bg-white">
      <div class="mx-auto flex max-w-container flex-col items-center justify-between gap-4 px-6 py-4 md:flex-row">
        <a href="/" class="flex items-center">
          <img src="/images/logo.png" alt="مدائن" class="h-9 w-auto md:h-10" />
        </a>
        <nav class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2">
          {navItems.map((item) => (
            <a href={item.href} class="text-[14px] font-normal text-[#0B1B3B] transition hover:text-madain-gold">
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <!-- Assembly section tabs -->
    <nav class="w-full border-b border-madain-gallery bg-[#FBF9F4]">
      <div class="mx-auto flex max-w-container flex-wrap justify-center gap-x-2 gap-y-1 px-6">
        {tabs.map((tab) => (
          <a
            href={tab.href}
            aria-current={active === tab.key ? 'page' : undefined}
            class:list={[
              'border-b-2 px-4 py-3 text-[14px] transition',
              active === tab.key
                ? 'border-madain-gold font-bold text-madain-goldDark'
                : 'border-transparent text-madain-tundora hover:text-madain-gold',
            ]}
          >
            {tab.label}
          </a>
        ))}
      </div>
    </nav>

    <main class="mx-auto max-w-[980px] px-5 py-10 md:px-6 md:py-12">
      <slot />
    </main>

    <footer class="w-full border-t border-madain-gallery bg-white">
      <div class="mx-auto flex max-w-container flex-col items-center justify-center gap-x-10 gap-y-3 px-6 py-5 text-[13px] text-madain-boulder md:flex-row">
        <span>للاستفسارات والمساعدة، يرجى التواصل معنا</span>
        <a href="mailto:investor.relations@madain.ae" class="inline-flex items-center gap-2 transition hover:text-madain-gold">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          investor.relations@madain.ae
        </a>
        <a href="tel:+971564777666" dir="ltr" class="inline-flex items-center gap-2 transition hover:text-madain-gold">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          +971 56 477 7666
        </a>
      </div>
    </footer>
  </body>
</html>
