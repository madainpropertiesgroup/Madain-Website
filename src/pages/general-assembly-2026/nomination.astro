---
import AgmLayout from '../../layouts/AgmLayout.astro';
import VerbatimNote from '../../components/VerbatimNote.astro';
import Clause from '../../components/Clause.astro';
import { meeting, NOMINATION_PDF, NOTICE_PDF } from '../../data/agm.js';
import { nomination, nominationAttachmentsIntro, nominationAttachments, nominationRest } from '../../data/notice.js';
---

<AgmLayout title="الترشح لعضوية مجلس الإدارة | الجمعية العمومية 2026" active="nomination">
  <header class="text-center">
    <h1 class="text-[24px] font-bold text-madain-shaft md:text-[30px]">الترشح لعضوية مجلس الإدارة</h1>
    <p class="font-inter mt-1 text-[12.5px] font-semibold uppercase tracking-[0.14em] text-madain-gold">
      Board Membership Nomination
    </p>
    <div class="mx-auto mt-4 h-px w-24 bg-madain-gold/50"></div>
  </header>

  <VerbatimNote href={NOTICE_PDF} />

  <!-- Dates -->
  <section class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="rounded-2xl border border-madain-gold/50 bg-[#FDF9F0] p-6 text-center">
      <div class="text-[13px] text-madain-boulder">فتح باب الترشح</div>
      <div class="mt-1.5 text-[16px] font-bold text-madain-goldDark">{meeting.publication}</div>
      <div class="mt-1 text-[12.5px] text-madain-boulder">تاريخ نشر الدعوة</div>
    </div>
    <div class="rounded-2xl border border-madain-gold/50 bg-[#FDF9F0] p-6 text-center">
      <div class="text-[13px] text-madain-boulder">إقفال باب الترشح</div>
      <div class="mt-1.5 text-[16px] font-bold text-madain-goldDark">{meeting.nominationDeadline}</div>
    </div>
  </section>

  <!-- 2.1 -->
  <section class="mt-6 rounded-2xl border border-madain-gold/35 bg-white p-6 shadow-sm md:p-8">
    <h2 class="text-[19px] font-bold text-madain-shaft">2. الترشح لعضوية مجلس الإدارة</h2>
    <div class="mt-5 space-y-3">
      {nomination.map((c) => <Clause n={c.n}>{c.text}</Clause>)}
    </div>
  </section>

  <!-- 2.2 -->
  <section class="mt-6 rounded-2xl border border-madain-gold/35 bg-white p-6 shadow-sm md:p-8">
    <h2 class="text-[18px] font-bold text-madain-shaft">
      <span class="font-inter" dir="ltr">{nominationAttachmentsIntro.n}</span> — {nominationAttachmentsIntro.text}
    </h2>
    <div class="mt-5 space-y-3">
      {nominationAttachments.map((c) => <Clause n={c.n}>{c.text}</Clause>)}
    </div>
  </section>

  <!-- 2.3 and 2.4 -->
  <section class="mt-6 space-y-3">
    {nominationRest.map((c) => <Clause n={c.n}>{c.text}</Clause>)}
  </section>

  <!-- Download -->
  <section class="mt-6 flex flex-col items-center gap-4 rounded-2xl border border-madain-gold/50 bg-[#FDF9F0] p-6 md:flex-row-reverse md:justify-between">
    <p class="text-center text-[13.5px] leading-relaxed text-madain-tundora md:text-right">
      نموذج الترشح المعتمد من الشركة، يُستوفى ويُوقّع ويُرفق بمستنداته المؤيدة.
    </p>
    <a
      href={NOMINATION_PDF}
      target="_blank"
      rel="noopener"
      class="inline-flex shrink-0 items-center gap-2 rounded-md bg-[#0B1B3B] px-7 py-3 text-[14px] font-bold text-white transition hover:bg-[#132a58]"
    >
      تحميل نموذج الترشح
    </a>
  </section>
</AgmLayout>
