---
import AgmLayout from '../../../layouts/AgmLayout.astro';
import { nominees } from '../../../data/nominees.js';
---

<AgmLayout title="قائمة المرشحين لعضوية مجلس الإدارة | الجمعية العمومية 2026" active="nominees">
  <header class="text-center">
    <h1 class="text-[24px] font-bold text-madain-shaft md:text-[30px]">قائمة المرشحين لعضوية مجلس الإدارة</h1>
    <p class="font-inter mt-1 text-[12.5px] font-semibold uppercase tracking-[0.14em] text-madain-gold">
      Board of Directors Nominees
    </p>
    <div class="mx-auto mt-4 h-px w-24 bg-madain-gold/50"></div>
  </header>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {nominees.map((nominee) => (
      <article class="flex flex-col rounded-xl border border-[#E8E2D4] bg-white p-3 text-center shadow-sm">
        <img
          src={nominee.photo}
          alt={nominee.name}
          class="aspect-[3/4] w-full rounded-lg object-cover object-top"
          width="300"
          height="400"
          loading="lazy"
        />
        <h2 class="mt-3 min-h-[48px] text-[14px] font-bold leading-snug text-madain-shaft">{nominee.name}</h2>
        <a
          href={`/general-assembly-2026/nominees/${nominee.slug}/`}
          class="mt-2 inline-block rounded-md border border-madain-gold px-3 py-1.5 text-[12.5px] font-medium text-madain-goldDark transition hover:bg-[#FBF9F4]"
        >
          عرض السيرة الذاتية
        </a>
      </article>
    ))}
  </div>

  <p class="mt-5 text-center text-[13.5px] text-madain-boulder">
    تم ترتيب أسماء المرشحين أبجدياً، ولا يعكس ترتيب الأسماء أي أفضلية أو توصية من الشركة لأي مرشح.
  </p>
</AgmLayout>
