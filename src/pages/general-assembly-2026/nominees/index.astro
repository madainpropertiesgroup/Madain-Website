---
import AgmLayout from '../../../layouts/AgmLayout.astro';
import { nominees } from '../../../data/nominees.js';

// Order below matches the approved publication list; the cards flow
// left-to-right exactly as in the supplied design.
const resources = [
  { ar: 'دعوة الجمعية العمومية', icon: 'megaphone', href: '/general-assembly-2026/documents/' },
  { ar: 'إجراءات الحضور والمشاركة عن بُعد', icon: 'remote', href: '/general-assembly-2026/attendance-voting/' },
  { ar: 'إجراءات التصويت الإلكتروني', icon: 'vote', href: '/general-assembly-2026/attendance-voting/' },
  { ar: 'نموذج / تعليمات التوكيل', icon: 'proxy', href: '/general-assembly-2026/forms/madain-proxy-form.pdf' },
  { ar: 'التواصل والاستفسارات', icon: 'support', href: '/general-assembly-2026/documents/' },
];
---

<AgmLayout title="المرشحون لعضوية مجلس الإدارة | الجمعية العمومية 2026" active="nominees">
  <!-- Hero -->
  <section class="relative isolate overflow-hidden rounded-2xl bg-[#0B2545] text-white">
    <img src="/images/agm-hero.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-20 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-[#0B2545]/90"></div>

    <div class="grid gap-6 p-7 md:grid-cols-[1fr_190px] md:items-center md:p-9">
      <div>
        <h1 class="text-[26px] font-bold leading-tight md:text-[32px]">المرشحون لعضوية مجلس الإدارة</h1>
        <p class="font-inter mt-1 text-[20px] font-semibold text-madain-straw md:text-[24px]">Board of Directors Nominees</p>
        <div class="mt-4 h-px w-56 bg-madain-straw/50"></div>

        <p class="mt-4 flex items-center gap-2.5 text-[14.5px] font-bold">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D5C68A" stroke-width="1.5" stroke-linecap="round">
            <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" />
          </svg>
          <span>2 سبتمبر 2026</span>
          <span class="text-white/40">|</span>
          <span>اجتماع الجمعية العمومية</span>
        </p>

        <p class="mt-4 max-w-[62ch] text-[14px] leading-relaxed text-white/80">
          فيما يلي قائمة المرشحين المعتمدين لعضوية مجلس إدارة شركة مدائن العقارية ش.م.خ، وفقاً لطلبات الترشح والمستندات
          المقدمة وإجراءات مراجعة طلبات الترشح.
        </p>
      </div>

      <aside class="mx-auto flex w-full max-w-[190px] flex-col items-center gap-4 rounded-xl border border-madain-straw/45 px-5 py-6 text-center">
        <div class="leading-none">
          <div class="text-[13.5px] font-bold text-madain-straw">الأربعاء</div>
          <div class="font-inter mt-1 text-[44px] font-bold leading-none text-madain-straw">02</div>
          <div class="mt-1.5 text-[15px] font-bold text-madain-straw">سبتمبر</div>
          <div class="font-inter text-[15px] text-madain-straw/90">2026</div>
        </div>
        <div class="h-px w-16 bg-madain-straw/40"></div>
        <div class="flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D5C68A" stroke-width="1.4" stroke-linecap="round">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
          </svg>
          <span class="text-[13px] text-madain-straw">الساعة 10:00 صباحاً</span>
        </div>
      </aside>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="mt-4 border-b border-[#EFE7D6] pb-3 text-[13px] text-madain-boulder" aria-label="مسار التنقل">
    <a href="/" class="transition hover:text-madain-gold">الرئيسية</a>
    <span class="px-2 text-madain-gold/60">›</span>
    <a href="/general-assembly-2026/" class="transition hover:text-madain-gold">الجمعية العمومية</a>
    <span class="px-2 text-madain-gold/60">›</span>
    <span class="text-madain-shaft">المرشحون لعضوية مجلس الإدارة</span>
  </nav>

  <!-- Nominees -->
  <section class="mt-8">
    <h2 class="text-center text-[22px] font-bold text-madain-shaft">القائمة النهائية للمرشحين المعتمدين للنشر</h2>
    <div class="mx-auto mt-3 h-px w-20 bg-madain-gold/60"></div>

    <div class="mt-7 flex flex-wrap justify-center gap-5">
      {nominees.map((nominee) => (
        <article class="flex w-full max-w-[290px] flex-col overflow-hidden rounded-xl border border-[#E8E2D4] bg-white shadow-sm sm:w-[calc(50%-10px)] lg:w-[calc(33.333%-14px)]">
          <img
            src={nominee.photo}
            alt={nominee.name}
            class="aspect-[4/3] w-full bg-[#F7F4EC] object-cover object-top"
            width="580"
            height="435"
            loading="lazy"
          />
          <div class="flex flex-1 flex-col items-center border-t border-[#EFE7D6] px-4 py-5 text-center">
            <div class="flex min-h-[104px] flex-col items-center justify-start">
            <h3 class="text-[16px] font-bold leading-snug text-[#0B2545]">{nominee.name}</h3>
            <p class="font-inter mt-1 text-[12px] font-semibold uppercase tracking-wide text-madain-gold">{nominee.nameEn}</p>
              <p class="mt-1.5 text-[13px] text-madain-boulder">{nominee.role}</p>
            </div>
            <a
              href={`/general-assembly-2026/nominees/${nominee.slug}/`}
              class="mt-auto inline-flex w-full items-center justify-center gap-2 rounded-md border border-madain-gold px-4 py-2 text-[13px] font-bold text-madain-goldDark transition hover:bg-[#FDF9F0] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-madain-gold"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" />
              </svg>
              عرض السيرة الذاتية
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-6 flex items-start justify-center gap-2 text-center text-[13.5px] text-madain-tundora">
      <svg class="mt-1 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="#9C8830">
        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-6h2zm0-8h-2V7h2z" />
      </svg>
      <span>تم ترتيب أسماء المرشحين أبجدياً، ولا يعكس ترتيب الأسماء أي أفضلية أو توصية من الشركة لأي مرشح.</span>
    </p>
  </section>

  <!-- Upcoming documents -->
  <section class="mt-8 rounded-2xl border border-[#E8E2D4] bg-[#FBF8F1] p-6 shadow-sm md:p-8">
    <h2 class="text-center text-[20px] font-bold text-madain-shaft">مستندات ومعلومات الجمعية العمومية</h2>
    <p class="font-inter text-center text-[13px] font-semibold uppercase tracking-[0.1em] text-madain-gold">
      AGM Documents &amp; Information
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {resources.map((item) => (
        <a
          href={item.href}
          class="flex flex-col items-center rounded-xl border border-[#EFE7D6] bg-white px-4 py-5 text-center transition hover:border-madain-gold hover:bg-[#FDFBF5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-madain-gold"
        >
          <span class="flex h-12 items-center">
            {item.icon === 'megaphone' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1z" /><path d="M15 8.5a4 4 0 0 1 0 7M18 6a7.5 7.5 0 0 1 0 12" />
              </svg>
            )}
            {item.icon === 'remote' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="5" width="19" height="12" rx="2" /><path d="M8 21h8M12 17v4" />
                <circle cx="12" cy="10" r="2" /><path d="M8.6 14a4 4 0 0 1 6.8 0" />
              </svg>
            )}
            {item.icon === 'vote' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="13" width="18" height="7" rx="1.6" /><path d="M7 13V6a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v7" />
                <path d="M9.5 9l1.8 1.8L15 7" />
              </svg>
            )}
            {item.icon === 'proxy' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" /><path d="M14 3v5h5" />
                <path d="M20.4 3.6a1.7 1.7 0 0 1 0 2.4l-5 5-2.6.6.6-2.6 5-5a1.7 1.7 0 0 1 2-.4z" />
              </svg>
            )}
            {item.icon === 'support' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.5 8.5 0 1 1-3.6-6.9" /><path d="M8.6 9.2a3.4 3.4 0 0 1 6.4 1.5c0 2.3-3.4 2.6-3.4 4.6" />
                <circle cx="11.6" cy="18" r=".9" fill="#9C8830" stroke="none" />
              </svg>
            )}
          </span>
          <h3 class="mt-2 min-h-[40px] text-[13.5px] font-bold leading-snug text-madain-shaft">{item.ar}</h3>
          <span class="mt-1 text-[12.5px] font-bold text-madain-goldDark">عرض</span>
        </a>
      ))}
    </div>
  </section>
</AgmLayout>
