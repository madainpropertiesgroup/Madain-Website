---
import AgmLayout from '../../../layouts/AgmLayout.astro';
import { nominees } from '../../../data/nominees.js';

export function getStaticPaths() {
  return nominees.map((nominee) => ({ params: { slug: nominee.slug }, props: { nominee } }));
}

const { nominee } = Astro.props;
---

<AgmLayout title={`${nominee.name} | مرشحو مجلس الإدارة — الجمعية العمومية 2026`} active="nominees">
  <nav class="mb-5 text-[13px] text-madain-boulder" aria-label="مسار التنقل">
    <a href="/general-assembly-2026/" class="transition hover:text-madain-gold">الجمعية العمومية 2026</a>
    <span class="px-2 text-madain-gold/60">/</span>
    <a href="/general-assembly-2026/nominees/" class="transition hover:text-madain-gold">المرشحون</a>
    <span class="px-2 text-madain-gold/60">/</span>
    <span class="text-madain-shaft">{nominee.name}</span>
  </nav>

  <!-- Profile header -->
  <section class="rounded-2xl border border-[#E8E2D4] bg-[#FDFBF6] p-6 shadow-sm md:p-8">
    <div class="grid gap-7 md:grid-cols-[210px_1fr] md:items-center">
      <div class="mx-auto w-full max-w-[210px] overflow-hidden rounded-xl border border-[#E8E2D4] bg-white">
        <img
          src={nominee.photo}
          alt={nominee.name}
          class="aspect-[3/4] w-full object-cover object-top"
          width="420"
          height="560"
          loading="eager"
        />
      </div>

      <div class="text-center md:text-right">
        <h1 class="text-[26px] font-bold leading-tight text-madain-shaft md:text-[32px]">{nominee.name}</h1>
        <p class="mt-1 font-inter text-[14px] font-semibold uppercase tracking-wide text-madain-gold">
          {nominee.nameEn}
        </p>

        <p class="mt-5 text-[17px] font-bold text-madain-shaft">{nominee.role}</p>
        <p class="font-inter text-[12px] font-semibold uppercase tracking-[0.12em] text-madain-boulder">
          Board of Directors Nominee
        </p>

        <div class="my-5 h-px w-full bg-madain-gold/35"></div>

        <p class="text-[15px] font-medium leading-relaxed text-madain-shaft">{nominee.summary}</p>
        <p class="mt-3 text-[13px] text-madain-boulder">
          المعلومات أدناه مستخرجة من السيرة الذاتية المقدمة ضمن ملف الترشح.
        </p>
      </div>
    </div>
  </section>

  <!-- Experience + education -->
  <div class="mt-6 grid gap-6 lg:grid-cols-[1.35fr_1fr]">
    <section class="rounded-2xl border border-[#E8E2D4] bg-white p-6 shadow-sm md:p-7">
      <h2 class="text-[19px] font-bold text-madain-shaft">أبرز الخبرات العملية</h2>
      <p class="font-inter text-[12px] font-semibold uppercase tracking-[0.12em] text-madain-gold">
        Selected Experience
      </p>

      <ul class="mt-5 divide-y divide-[#EFEADD]">
        {nominee.experience.map((item) => (
          <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <div class="sm:order-2 sm:shrink-0">
              <span class="font-inter text-[13.5px] font-semibold text-madain-goldDark">{item.period}</span>
            </div>
            <div class="sm:order-1">
              <div class="text-[15px] font-bold text-madain-shaft">{item.org}</div>
              {item.role && <div class="mt-0.5 text-[13.5px] text-madain-boulder">{item.role}</div>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="rounded-2xl border border-[#E8E2D4] bg-white p-6 shadow-sm md:p-7">
      <h2 class="text-[19px] font-bold text-madain-shaft">المؤهلات</h2>
      <p class="font-inter text-[12px] font-semibold uppercase tracking-[0.12em] text-madain-gold">Education</p>

      <ul class="mt-5 space-y-4">
        {nominee.education.map((item) => (
          <li>
            <div class="text-[14.5px] font-bold leading-snug text-madain-shaft">{item.degree}</div>
            <div class="mt-0.5 text-[13.5px] text-madain-boulder">{item.place}</div>
            <div class="mt-0.5 font-inter text-[13px] font-semibold text-madain-goldDark">{item.year}</div>
          </li>
        ))}
      </ul>

      {nominee.courses && (
        <div class="mt-6 border-t border-[#EFEADD] pt-5">
          <h3 class="text-[15px] font-bold text-madain-shaft">دورات إضافية</h3>
          <ul class="mt-2 space-y-1 text-[13.5px] text-madain-boulder">
            {nominee.courses.map((course) => (
              <li>{course}</li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </div>

  <!-- CV bar -->
  <section class="mt-6 rounded-2xl border border-madain-gold/60 bg-[#FDFBF1] p-5 shadow-sm md:p-6">
    <div class="flex flex-col items-center gap-4 md:flex-row-reverse md:justify-between">
      <p class="max-w-[70ch] text-center text-[13.5px] leading-relaxed text-madain-tundora md:text-right">
        {nominee.note}
      </p>
      <a
        href={nominee.cv}
        target="_blank"
        rel="noopener"
        class="inline-flex w-full max-w-[260px] shrink-0 flex-col items-center rounded-md border-2 border-madain-gold bg-[#0B1B3B] px-8 py-3 text-center transition hover:bg-[#132a58] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-madain-gold"
      >
        <span class="text-[15px] font-bold text-madain-straw">عرض السيرة الذاتية</span>
        <span class="font-inter text-[11px] font-semibold uppercase tracking-[0.14em] text-white">View Original CV</span>
      </a>
    </div>
  </section>

  <nav class="mt-6 text-center">
    <a href="/general-assembly-2026/nominees/" class="text-[14px] text-madain-goldDark transition hover:text-madain-gold">
      العودة إلى قائمة المرشحين
    </a>
  </nav>
</AgmLayout>
