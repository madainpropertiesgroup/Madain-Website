---
import AgmLayout from '../../../layouts/AgmLayout.astro';
import { nominees } from '../../../data/nominees.js';
import { nomineeProfiles } from '../../../data/nomineeProfiles.js';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return nominees.map((nominee) => ({params: {slug: nominee.slug}, props: {nominee}}));
}
const { nominee } = Astro.props;
const profile = nomineeProfiles[nominee.slug];
const root = path.resolve('public');
const findPhoto = ['jpg','jpeg','png','webp'].map(ext => `images/nominees/${nominee.slug}.${ext}`).find(p => fs.existsSync(path.join(root,p)));
const photo = nominee.photo || (findPhoto ? '/' + findPhoto : '');
const cvPath = `general-assembly-2026/cv/${nominee.slug}.pdf`;
const cv = nominee.cv || (fs.existsSync(path.join(root,cvPath)) ? '/'+cvPath : '');
---
<AgmLayout title={`${nominee.name} | الملف التعريفي للمرشح — مدائن العقارية`} active="nominees">
  <nav class="mb-5 text-[13px] text-madain-boulder" aria-label="مسار التنقل">
    <a href="/general-assembly-2026/nominees/" class="hover:text-madain-gold">المرشحون لعضوية مجلس الإدارة</a>
    <span class="px-2">‹</span><span>{nominee.name}</span>
  </nav>
  <section class="rounded-2xl border border-[#E8E2D4] bg-[#FDFBF6] p-6 shadow-sm md:p-8">
    <div class="grid gap-7 md:grid-cols-[210px_1fr] md:items-center">
      {photo && <img src={photo} alt={nominee.name} class="aspect-[4/5] w-full rounded-xl border border-[#E8E2D4] bg-white object-contain" width="420" height="525" loading="eager" />}
      <div>
        <h1 class="text-[26px] font-bold text-[#0B2545] md:text-[32px]">{nominee.name}</h1>
        <p class="mt-2 text-[15px] text-madain-boulder">{nominee.role}</p>
        <div class="my-5 h-px bg-madain-gold/35"></div>
        <h2 class="text-[18px] font-bold text-[#0B2545]">الملف التعريفي للمرشح</h2>
        <p class="mt-2 text-[13px] leading-7 text-madain-boulder">المعلومات المهنية التالية مستخلصة من السيرة الذاتية المقدمة من المرشح، ولا تُعد تحققاً مستقلاً من الجهات المذكورة.</p>
      </div>
    </div>
  </section>
  <section class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl border border-[#E8E2D4] bg-white p-5">
      <h2 class="font-bold text-[#0B2545]">المؤهلات العلمية</h2>
      {profile.degrees.length ? <ul class="mt-3 list-inside list-disc space-y-2 text-[14px] leading-7 text-madain-boulder">{profile.degrees.map(degree => <li>{degree}</li>)}</ul> : <p class="mt-3 text-[14px] text-madain-boulder">يرجى الرجوع إلى السيرة الذاتية الأصلية للاطلاع على المؤهلات.</p>}
    </div>
    <div class="rounded-xl border border-[#E8E2D4] bg-white p-5">
      <h2 class="font-bold text-[#0B2545]">سنوات الخبرة</h2><p class="mt-3 text-[14px] leading-7 text-madain-boulder">{profile.experienceYears}</p>
    </div>
    <div class="rounded-xl border border-[#E8E2D4] bg-white p-5">
      <h2 class="font-bold text-[#0B2545]">صفة العضوية والاستقلالية</h2>
      <p class="mt-3 text-[14px] leading-7 text-madain-boulder">لم تُعتمد صفة الاستقلالية أو طبيعة العضوية للنشر بعد؛ ويستلزم بيانها الرجوع إلى الإقرارات ومراجعتها قانونياً.</p>
    </div>
    <div class="rounded-xl border border-[#E8E2D4] bg-white p-5">
      <h2 class="font-bold text-[#0B2545]">أبرز مجالات الخبرة</h2><p class="mt-3 text-[14px] leading-7 text-madain-boulder">{profile.expertise}</p>
    </div>
  </section>
  <section class="mt-6 rounded-xl border border-[#E8E2D4] bg-white p-6">
    <h2 class="text-[19px] font-bold text-[#0B2545]">أبرز جهات العمل والخبرات السابقة المذكورة في السيرة</h2>
    <ul class="mt-3 list-inside list-disc space-y-2 text-[14px] leading-7 text-madain-boulder">{profile.careers.map(org => <li>{org}</li>)}</ul>
  </section>
  <section class="mt-6 rounded-xl border border-[#E8E2D4] bg-white p-6">
    <h2 class="text-[19px] font-bold text-[#0B2545]">عضويات مجالس الإدارة والإفصاحات</h2>
    <p class="mt-3 text-[14px] leading-7 text-madain-boulder">لم تُدرج هنا قائمة بالعضويات الحالية أو المصالح ذات العلاقة قبل توثيقها من إقرارات المرشح ومراجعتها. وقد تتضمن السيرة الذاتية الأصلية تفاصيل عن عضويات أو مناصب سابقة.</p>
  </section>
  {cv && <section class="mt-6 rounded-xl border border-madain-gold/60 bg-[#FDFBF1] p-6 text-center">
    <a href={cv} target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-md bg-[#0B2545] px-6 py-3 text-[15px] font-bold text-white hover:bg-[#132a58]">عرض السيرة الذاتية الأصلية PDF</a>
  </section>}
  <nav class="mt-6 text-center"><a href="/general-assembly-2026/nominees/" class="text-[14px] font-bold text-madain-goldDark hover:underline">العودة إلى قائمة المرشحين</a></nav>
</AgmLayout>
