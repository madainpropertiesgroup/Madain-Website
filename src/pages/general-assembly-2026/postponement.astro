---
// The announcement, and the approved minutes attached as the document that
// proves it.
//
// The page reproduces nothing from the minutes. That document is filed with
// the Ministry of Economy and Tourism and the competent authority, and a
// second account of it published here could drift from the one on file. The
// announcement carries what a shareholder has to act on; the detail stays in
// the document.
//
// The attachment is all-or-nothing: without the approved PDF the page shows
// no attachment section at all, not a link that leads nowhere and not a notice
// promising a document on a date nobody has fixed.
import fs from 'node:fs';
import path from 'node:path';
import AgmLayout from '../../layouts/AgmLayout.astro';
import VenueCard from '../../components/VenueCard.astro';
import { meeting } from '../../data/agm.js';
import {
  eyebrow,
  headline,
  body,
  attachmentBody,
  attachmentLabel,
  MINUTES_PDF_PATH,
} from '../../data/postponement.js';

const minutes = fs.existsSync(path.join(path.resolve('public'), MINUTES_PDF_PATH))
  ? '/' + MINUTES_PDF_PATH
  : '';
---

<AgmLayout title="إعلان تأجيل اجتماع الجمعية العمومية | مدائن العقارية ش.م.خ" active="postponement">
  <article class="mx-auto max-w-[78ch]">
    <header class="text-center">
      <p class="text-[13px] font-bold tracking-wide text-madain-goldDark">{eyebrow}</p>
      <div class="mx-auto mt-3 h-px w-20 bg-madain-gold/50"></div>
      <h1 class="mt-5 text-[23px] font-bold leading-snug text-[#0B2545] md:text-[29px]">{headline}</h1>
    </header>

    <section class="mt-8 rounded-2xl border border-madain-gold/40 bg-[#FDFBF1] p-6 shadow-sm md:p-9">
      {body.map((para) => (
        <p class="text-[15px] leading-[2.15] text-madain-tundora [&:not(:first-child)]:mt-5">
          {para.map((run) => (run.b ? <b class="text-[#0B2545]">{run.t}</b> : <span>{run.t}</span>))}
        </p>
      ))}

      {minutes && (
        <>
          <div class="my-7 h-px w-full bg-madain-gold/25"></div>
          <p class="text-[15px] leading-[2.15] text-madain-tundora">
            {attachmentBody.map((run) => (run.b ? <b class="text-[#0B2545]">{run.t}</b> : <span>{run.t}</span>))}
          </p>
          <a
            href={minutes}
            target="_blank"
            rel="noopener"
            class="mt-5 inline-flex items-center gap-2.5 rounded-md bg-[#0B2545] px-6 py-3.5 text-[14px] font-bold text-white transition hover:bg-[#153a67] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-madain-gold"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 3v5h5" /><path d="M19 8v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7z" />
            </svg>
            {attachmentLabel}
          </a>
        </>
      )}
    </section>

    <!-- The venue, as the published convocation names it -->
    <div class="mt-6"><VenueCard /></div>

    <p class="mt-6 text-center text-[13px] leading-relaxed text-madain-boulder">
      اجتماع الجمعية العمومية — {meeting.full}، الساعة {meeting.time}.
    </p>
  </article>
</AgmLayout>
