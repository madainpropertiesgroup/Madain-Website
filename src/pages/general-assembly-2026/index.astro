---
import AgmLayout from '../../layouts/AgmLayout.astro';
import { meeting, agenda, contacts, NOTICE_PDF, NOMINATION_PDF } from '../../data/agm.js';

const dates = [
  { label: 'إقفال باب الترشح', value: meeting.nominationDeadline, note: `فُتح الباب بتاريخ النشر ${meeting.publication}` },
  { label: 'الموعد النهائي للتوكيلات', value: meeting.proxyDeadline, note: 'إلى سوق دبي المالي' },
  { label: 'اجتماع الجمعية', value: meeting.full, note: `الساعة ${meeting.time}` },
  { label: 'الاجتماع الثاني', value: meeting.secondMeeting, note: 'عند عدم اكتمال النصاب' },
];

const sections = [
  {
    title: 'الترشح لعضوية مجلس الإدارة',
    text: 'الشروط والمستندات المطلوبة وطريقة التقديم قبل إقفال باب الترشح.',
    href: '/general-assembly-2026/nomination/',
  },
  {
    title: 'الحضور والتسجيل والتصويت',
    text: 'الحضور الشخصي أو بالإنابة، التوكيلات، سجل الحضور، وآلية التصويت.',
    href: '/general-assembly-2026/attendance-voting/',
  },
  {
    title: 'الدعوة والمستندات',
    text: 'نص الدعوة المنشورة وجدول الأعمال ونموذج الترشح للتحميل.',
    href: '/general-assembly-2026/documents/',
  },
];
---

<AgmLayout title="الجمعية العمومية 2026 | مدائن العقارية ش.م.خ" active="meeting">
  <!-- Hero -->
  <section class="overflow-hidden rounded-2xl bg-[#0B2545] text-white shadow-md">
    <div class="flex flex-col gap-8 p-7 md:flex-row md:items-center md:p-10">
      <div class="shrink-0 text-center md:border-l md:border-white/15 md:pl-10">
        <div class="text-[14px] text-white/80">{meeting.day}</div>
        <div class="font-inter text-[56px] font-extrabold leading-none text-madain-straw md:text-[68px]">
          {meeting.date}
        </div>
        <div class="mt-1 text-[17px] font-bold">{meeting.month}</div>
        <div class="font-inter text-[15px] text-white/80">{meeting.year}</div>
        <div class="mt-4 border-t border-white/15 pt-4 text-[14px]">
          <span class="block text-white/70">الساعة</span>
          <b>{meeting.time}</b>
        </div>
      </div>

      <div class="flex-1">
        <p class="font-inter text-[11.5px] font-semibold uppercase tracking-[0.16em] text-madain-straw">
          General Assembly Meeting
        </p>
        <h1 class="mt-2 text-[26px] font-bold leading-snug md:text-[32px]">
          دعوة لحضور اجتماع الجمعية العمومية
        </h1>
        <p class="mt-4 max-w-[60ch] text-[14.5px] leading-loose text-white/85">
          يدعو السيد/ <b class="text-madain-straw">{meeting.chairman}</b> — {meeting.chairmanTitle} — السادة
          المساهمين لحضور اجتماع الجمعية العمومية المقرر عقده <b class="text-madain-straw">حضورياً</b> في
          {' '}{meeting.venue}، {meeting.venueDetail}. ويبدأ التسجيل في مقر الاجتماع الساعة {meeting.registration}.
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href={NOTICE_PDF}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 rounded-md bg-madain-gold px-6 py-3 text-[14px] font-bold text-white transition hover:bg-madain-goldDark"
          >
            تحميل الدعوة المنشورة
          </a>
          <a
            href={NOMINATION_PDF}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 rounded-md border border-white/40 px-6 py-3 text-[14px] font-bold text-white transition hover:bg-white/10"
          >
            تحميل نموذج الترشح
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key dates -->
  <section class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {dates.map((item) => (
      <article class="rounded-xl border border-[#E8E2D4] bg-white p-5 text-center shadow-sm">
        <div class="text-[12.5px] text-madain-boulder">{item.label}</div>
        <div class="mt-1.5 text-[15.5px] font-bold text-madain-goldDark">{item.value}</div>
        <div class="mt-1 text-[12.5px] text-madain-boulder">{item.note}</div>
      </article>
    ))}
  </section>

  <!-- Agenda -->
  <section class="mt-6 rounded-2xl border border-madain-gold/35 bg-white p-6 shadow-sm md:p-8">
    <h2 class="text-[19px] font-bold text-madain-shaft">جدول الأعمال</h2>
    <p class="font-inter mt-1 text-[11.5px] font-semibold uppercase tracking-[0.12em] text-madain-gold">Agenda</p>
    <div class="mt-4 h-px w-20 bg-madain-gold/50"></div>

    <ol class="mt-5 divide-y divide-dashed divide-[#EFE7D6]">
      {agenda.map((item, index) => (
        <li class="flex items-start gap-3 py-3.5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#0B2545] font-inter text-[12px] font-bold text-white">
            {index + 1}
          </span>
          <span class="text-[14px] leading-relaxed text-madain-tundora">{item}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- Sections -->
  <section class="mt-6 grid gap-4 md:grid-cols-3">
    {sections.map((section) => (
      <a
        href={section.href}
        class="group rounded-2xl border border-[#E8E2D4] bg-white p-6 shadow-sm transition hover:border-madain-gold/60 hover:shadow-md"
      >
        <h3 class="text-[16px] font-bold text-madain-shaft group-hover:text-madain-goldDark">{section.title}</h3>
        <p class="mt-2 text-[13.5px] leading-relaxed text-madain-boulder">{section.text}</p>
        <span class="mt-4 inline-block text-[13px] font-bold text-madain-goldDark">عرض التفاصيل ←</span>
      </a>
    ))}
  </section>

  <!-- Contact -->
  <section class="mt-6 rounded-2xl border border-[#E8E2D4] bg-white p-6 text-center shadow-sm">
    <h2 class="text-[16px] font-bold text-madain-shaft">للاستفسارات</h2>
    <p class="mx-auto mt-2 max-w-[62ch] text-[13.5px] leading-relaxed text-madain-boulder">
      لأي استفسار بشأن الجمعية العمومية أو المستندات أو إجراءات الترشح، يرجى التواصل عبر البريد الإلكتروني
      {' '}<span class="font-inter font-semibold text-madain-goldDark" dir="ltr">{contacts.legal}</span>،
      أو مع فريق دعم المساهمين لدى الشركة على واتساب
      {' '}<span class="font-inter font-semibold text-madain-goldDark" dir="ltr">{contacts.whatsapp}</span>.
    </p>
  </section>
</AgmLayout>
