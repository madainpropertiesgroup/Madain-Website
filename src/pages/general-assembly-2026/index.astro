---
import AgmLayout from '../../layouts/AgmLayout.astro';
---

<AgmLayout title="موعد ومكان الاجتماع | الجمعية العمومية 2026 — مدائن العقارية" active="meeting">
  <header class="text-center">
    <h1 class="text-[26px] font-bold text-madain-goldDark md:text-[32px]">موعد ومكان الاجتماع</h1>
    <p class="mt-2 text-[15px] text-madain-boulder">الجمعية العمومية لشركة مدائن العقارية ش.م.خ</p>
    <div class="mx-auto mt-4 h-px w-24 bg-madain-gold/50"></div>
  </header>

  <!-- Date / time card -->
  <section class="mt-8 rounded-xl border border-[#E8E2D4] bg-white p-6 shadow-sm md:p-8">
    <div class="grid items-center gap-8 md:grid-cols-[220px_1fr]">
      <div class="mx-auto w-full max-w-[220px] rounded-xl border-2 border-madain-gold/70 px-6 py-5 text-center">
        <div class="relative -mt-9 mb-3 flex justify-center gap-8">
          <span class="h-5 w-1.5 rounded-full bg-madain-gold"></span>
          <span class="h-5 w-1.5 rounded-full bg-madain-gold"></span>
        </div>
        <div class="text-[15px] font-medium text-madain-goldDark">الأربعاء</div>
        <div class="font-inter text-[54px] font-bold leading-none text-madain-goldDark">02</div>
        <div class="mt-1 text-[17px] font-medium text-madain-goldDark">سبتمبر</div>
        <div class="font-inter text-[17px] text-madain-goldDark">2026</div>
      </div>

      <div class="divide-y divide-[#EFEADD]">
        <div class="flex items-center gap-4 pb-5">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.4" stroke-linecap="round">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
          </svg>
          <div>
            <div class="text-[15px] font-bold text-madain-shaft">الساعة</div>
            <div class="text-[15px] text-madain-boulder">10:00 صباحاً</div>
          </div>
        </div>
        <div class="flex items-center gap-4 pt-5">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9.5" cy="7" r="3.2" />
            <path d="M22 20v-2a4 4 0 0 0-3-3.87M16.5 4.2a3.2 3.2 0 0 1 0 5.6" />
          </svg>
          <div>
            <div class="text-[15px] font-bold text-madain-shaft">الجمعية العمومية</div>
            <div class="text-[15px] text-madain-boulder">لعام 2026</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Attendance options -->
  <section class="mt-10">
    <h2 class="text-center text-[19px] font-bold text-madain-goldDark">خيارات الحضور</h2>
    <div class="mt-5 grid gap-5 md:grid-cols-2">
      <article class="rounded-xl border border-[#E8E2D4] bg-white p-6 shadow-sm">
        <div class="flex items-start gap-4">
          <svg class="mt-1 shrink-0" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" /><circle cx="12" cy="10" r="2.6" />
          </svg>
          <div>
            <h3 class="text-[17px] font-bold text-madain-shaft">حضور شخصي</h3>
            <p class="mt-1.5 text-[14px] text-madain-boulder">الحضور في مقر الاجتماع حسب العنوان الموضح أدناه</p>
          </div>
        </div>
      </article>

      <article class="rounded-xl border border-[#E8E2D4] bg-white p-6 shadow-sm">
        <div class="flex items-start gap-4">
          <svg class="mt-1 shrink-0" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="13" rx="2" /><path d="M8 21h8M12 17v4" />
            <circle cx="12" cy="9.5" r="2.2" /><path d="M8.4 14a4 4 0 0 1 7.2 0" />
          </svg>
          <div>
            <h3 class="text-[17px] font-bold text-madain-shaft">حضور عن بُعد</h3>
            <p class="mt-1.5 text-[14px] text-madain-boulder">عبر تقنية الاتصال المرئي والتصويت الإلكتروني</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Venue -->
  <section class="mt-6 rounded-xl border border-[#E8E2D4] bg-white p-6 shadow-sm md:p-7">
    <div class="flex flex-col gap-4 md:flex-row md:items-start">
      <svg class="shrink-0" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" /><circle cx="12" cy="10" r="2.6" />
      </svg>
      <div>
        <h2 class="text-[18px] font-bold text-madain-shaft">موقع الاجتماع (الحضور الشخصي)</h2>
        <address class="mt-2 space-y-0.5 text-[14px] not-italic leading-relaxed text-madain-boulder" dir="ltr">
          <div>Grant Thornton</div>
          <div>The Offices 5, Level 3, Office 303</div>
          <div>One Central, Dubai World Trade Centre</div>
          <div>Dubai, United Arab Emirates</div>
        </address>
      </div>
    </div>
  </section>

  <!-- Second meeting -->
  <section class="mt-6 rounded-xl border border-[#E8E2D4] bg-[#FBF9F4] p-6 shadow-sm md:p-7">
    <div class="flex flex-col gap-4 md:flex-row md:items-start">
      <svg class="shrink-0" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" />
        <path d="M7.5 14h2M11 14h2M14.5 14h2M7.5 17.5h2M11 17.5h2" />
      </svg>
      <div>
        <h2 class="text-[18px] font-bold text-madain-shaft">الاجتماع الثاني (عند الحاجة)</h2>
        <p class="mt-1.5 text-[15px] font-bold text-madain-goldDark">الأربعاء 9 سبتمبر 2026</p>
        <p class="mt-2 max-w-[62ch] text-[14px] text-madain-boulder">
          في حال عدم اكتمال النصاب القانوني، سيعقد الاجتماع الثاني في نفس المكان والوقت المحدد أعلاه.
        </p>
      </div>
    </div>
  </section>
</AgmLayout>
