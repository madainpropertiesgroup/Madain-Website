---
import AgmLayout from '../../layouts/AgmLayout.astro';
import Clause from '../../components/Clause.astro';
import { meeting, NOTICE_PDF, NOMINATION_PDF, PROXY_PDF_AR, PROXY_PDF_EN, PRESS_ALWATAN, PRESS_ALIQTISADI } from '../../data/agm.js';
import {
  source, preamble, agenda, nomination, nominationAttachmentsIntro,
  nominationAttachments, nominationRest, notes, closing, issuer,
} from '../../data/notice.js';

const files = [
  { ar: 'دعوة الجمعية العمومية المنشورة', en: 'AGM Notice', href: NOTICE_PDF },
  { ar: 'نموذج الترشح لعضوية مجلس الإدارة', en: 'Nomination Form', href: NOMINATION_PDF },
  { ar: 'نموذج التوكيل — عربي', en: 'Proxy Form (Arabic)', href: PROXY_PDF_AR },
  { ar: 'نموذج التوكيل — إنجليزي', en: 'Proxy Form (English)', href: PROXY_PDF_EN },
  { ar: 'جريدة الوطن — العدد كاملاً (الإعلان صفحة 6)', en: 'Al Watan — Full Issue', href: PRESS_ALWATAN },
  { ar: 'جريدة الاقتصادي — العدد كاملاً (الإعلان صفحة 3)', en: 'Al Iqtisadi — Full Issue', href: PRESS_ALIQTISADI },
];
---

<AgmLayout title="نص الدعوة والمستندات | الجمعية العمومية 2026" active="documents">
  <header class="text-center">
    <h1 class="text-[24px] font-bold text-madain-shaft md:text-[30px]">نص الدعوة والمستندات</h1>
    <p class="font-inter mt-1 text-[12.5px] font-semibold uppercase tracking-[0.14em] text-madain-gold">
      Notice &amp; Documents
    </p>
    <p class="mt-3 text-[14.5px] font-bold text-madain-shaft">
      {meeting.full} &nbsp;|&nbsp; الساعة {meeting.time}
    </p>
    <div class="mx-auto mt-4 h-px w-24 bg-madain-gold/50"></div>
  </header>

  <!-- Downloads -->
  <section class="mt-7 rounded-2xl border border-madain-gold/35 bg-white p-6 shadow-sm md:p-7">
    <h2 class="text-[18px] font-bold text-madain-shaft">المستندات للتحميل</h2>
    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      {files.map((file) => (
        <a
          href={file.href}
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between gap-3 rounded-xl border border-[#EFEADD] bg-[#FBF9F4] px-4 py-3.5 transition hover:border-madain-gold/60 hover:bg-[#FDF9F0]"
        >
          <span class="text-right">
            <span class="block text-[14px] font-bold text-madain-shaft">{file.ar}</span>
            <span class="font-inter block text-[11px] uppercase tracking-[0.1em] text-madain-boulder">{file.en}</span>
          </span>
          <span class="shrink-0 text-[13px] font-bold text-madain-goldDark">عرض</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Full verbatim text -->
  <section class="mt-6 rounded-2xl border border-madain-gold/35 bg-white p-6 shadow-sm md:p-8">
    <h2 class="text-[20px] font-bold text-madain-shaft">نص الدعوة المنشورة كاملاً</h2>
    <p class="mt-2 text-[13px] leading-relaxed text-madain-boulder">{source.label}</p>
    <p class="mt-3 rounded-xl border border-madain-gold/40 bg-[#FDF9F0] px-5 py-4 text-[13px] leading-relaxed text-madain-tundora">
      {source.note}
    </p>

    <div class="mt-6 space-y-4">
      {preamble.map((para) => (
        <p class="text-[13.5px] leading-loose text-madain-tundora">{para}</p>
      ))}
    </div>

    <h3 class="mt-8 text-[18px] font-bold text-madain-shaft">1. جدول الأعمال</h3>
    <div class="mt-4 space-y-3">
      {agenda.map((c) => <Clause n={c.n}>{c.text}</Clause>)}
    </div>

    <h3 class="mt-8 text-[18px] font-bold text-madain-shaft">2. الترشح لعضوية مجلس الإدارة</h3>
    <div class="mt-4 space-y-3">
      {nomination.map((c) => <Clause n={c.n}>{c.text}</Clause>)}
      <Clause n={nominationAttachmentsIntro.n}>{nominationAttachmentsIntro.text}</Clause>
      <div class="space-y-3 pr-4 md:pr-10">
        {nominationAttachments.map((c) => <Clause n={c.n}>{c.text}</Clause>)}
      </div>
      {nominationRest.map((c) => <Clause n={c.n}>{c.text}</Clause>)}
    </div>

    <h3 class="mt-8 text-[18px] font-bold text-madain-shaft">3. ملاحظات مهمة</h3>
    <div class="mt-4 space-y-3">
      {notes.map((c) => <Clause n={c.n} title={c.title}>{c.text}</Clause>)}
    </div>

    <p class="mt-6 text-[13.5px] leading-loose text-madain-tundora">{closing}</p>

    <div class="mt-8 rounded-2xl border border-[#E8E2D4] bg-[#FBF9F4] p-6 text-center">
      <p class="text-[12.5px] uppercase tracking-[0.14em] text-madain-gold">{issuer.heading}</p>
      <p class="mt-2 text-[17px] font-bold text-madain-shaft">{issuer.name}</p>
      <p class="mx-auto mt-1 max-w-[60ch] text-[13.5px] leading-relaxed text-madain-boulder">{issuer.title}</p>
    </div>
  </section>

  <!-- Press -->
  <section class="mt-6 rounded-2xl border border-madain-gold/35 bg-white p-6 shadow-sm md:p-7">
    <div class="grid items-center gap-6 md:grid-cols-[1fr_auto]">
      <div>
        <h2 class="text-[18px] font-bold text-madain-shaft">الدعوة كما نُشرت في الصحف المحلية</h2>
        <p class="mt-2 max-w-[62ch] text-[13.5px] leading-relaxed text-madain-boulder">
          نُشرت الدعوة يوم {meeting.publication}. ويمكنكم تحميل نسخة العدد كاملاً من كل صحيفة كما صدر — الإعلان في
          جريدة الوطن بالصفحة 6، وفي جريدة الاقتصادي بالصفحة 3.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={PRESS_ALWATAN}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center rounded-md bg-madain-gold px-6 py-2.5 text-[13.5px] font-bold text-white transition hover:bg-madain-goldDark"
        >
          جريدة الوطن — صفحة 6
        </a>
        <a
          href={PRESS_ALIQTISADI}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center rounded-md border border-madain-gold px-6 py-2.5 text-[13.5px] font-bold text-madain-goldDark transition hover:bg-[#FDF9F0]"
        >
          جريدة الاقتصادي — صفحة 3
        </a>
      </div>
    </div>
  </section>
</AgmLayout>
