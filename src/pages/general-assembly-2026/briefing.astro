---
import AgmLayout from '../../layouts/AgmLayout.astro';
import PostponementNotice from '../../components/PostponementNotice.astro';
import { meeting } from '../../data/agm.js';
import {
  header, intro, timelineTitle, timelineHead, timeline,
  sections, accessTitle, accessBody, disclaimer, footer,
} from '../../data/briefing.js';

// Every string on this page comes from src/data/briefing.js, which is a
// verbatim transcription of the company's own document. The markup arranges
// that text; it never rewrites it.
const items = sections.filter((s) => s.item).map((s) => s.item);

---

<AgmLayout title="عرض للمساهمين بشأن التقارير والمستندات | الجمعية العمومية 2026" active="briefing">
  <PostponementNotice />

  <!-- Hero -->
  <section class="mt-6 overflow-hidden rounded-2xl bg-[#0B2545] text-white">
    <div class="p-7 md:p-9">
      <p class="text-[13px] font-bold tracking-wide text-madain-straw">{header.company}</p>
      <h1 class="mt-2 text-[22px] font-bold leading-snug md:text-[29px]">{header.title}</h1>
      <div class="mt-4 h-px w-56 bg-madain-straw/50"></div>

      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {[header.meeting1, header.meeting2].map((line) => (
          <p class="flex items-start gap-2.5 rounded-xl border border-madain-straw/35 px-4 py-3 text-[13.5px] leading-relaxed">
            <svg class="mt-0.5 shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#D5C68A" stroke-width="1.5" stroke-linecap="round">
              <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" />
            </svg>
            <span>{line}</span>
          </p>
        ))}
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="mt-4 border-b border-[#EFE7D6] pb-3 text-[13px] text-madain-boulder" aria-label="مسار التنقل">
    <a href="/" class="transition hover:text-madain-gold">الرئيسية</a>
    <span class="px-2 text-madain-gold/60">›</span>
    <a href="/general-assembly-2026/" class="transition hover:text-madain-gold">الجمعية العمومية</a>
    <span class="px-2 text-madain-gold/60">›</span>
    <span class="text-madain-shaft">عرض للمساهمين</span>
  </nav>

  <!-- Intro + agenda jumps -->
  <section class="mt-6 rounded-2xl border border-[#E8E2D4] bg-white p-6 shadow-sm md:p-7">
    <p class="text-[14px] leading-loose text-madain-tundora">{intro}</p>
    <div class="mt-5 flex flex-wrap items-center gap-2.5">
      {sections.map((s) => (
        <a
          href={`#s-${s.ord}`}
          class="inline-flex items-center gap-2 rounded-lg border border-[#EFE7D6] bg-[#FDFBF5] px-3.5 py-2 text-[13px] font-bold text-madain-shaft transition hover:border-madain-gold"
        >
          {s.item && (
            <span class="font-inter rounded bg-[#0B2545] px-1.5 py-0.5 text-[11px] font-bold text-white" dir="ltr">
              {s.item}
            </span>
          )}
          {s.ord}
        </a>
      ))}
    </div>
  </section>

  <!-- Timeline -->
  <section class="mt-8">
    <h2 class="text-center text-[21px] font-bold text-madain-shaft">{timelineTitle}</h2>
    <div class="mx-auto mt-3 h-px w-20 bg-madain-gold/60"></div>
    <p class="sr-only">{timelineHead.join('، ')}</p>

    <ol class="relative mt-6 border-r-2 border-[#EDE6D5] pr-5 md:pr-7">
      {timeline.map((row) => (
        <li class="relative pb-3.5 last:pb-0">
          <span class="absolute right-[-27px] top-2 h-2.5 w-2.5 rounded-full border-2 border-white bg-madain-gold md:right-[-34px]"></span>
          <div class="rounded-lg border border-[#EDE6D5] bg-white px-4 py-2.5 md:flex md:items-baseline md:gap-4">
            <span class="font-inter shrink-0 text-[12.5px] font-bold tracking-wide text-madain-goldDark md:w-[108px]">{row.date}</span>
            <span class="mt-1 block text-[13px] leading-relaxed text-madain-tundora md:mt-0">
              {row.event}
              <span class="text-[12px] text-madain-boulder"> — {timelineHead[2]}: {row.source}</span>
            </span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <div class="mt-9 flex flex-wrap items-center justify-between gap-3 border-b border-[#EFE7D6] pb-4">
    <h2 class="text-[19px] font-bold text-madain-shaft">أقسام العرض</h2>
    <div class="flex flex-wrap gap-2.5">
      <button type="button" data-all="open" class="rounded-lg bg-[#0B2545] px-3.5 py-2 text-[12.5px] font-bold text-white transition hover:bg-[#143a68]">فتح جميع الأقسام</button>
      <button type="button" data-all="close" class="rounded-lg border border-[#DDD4BC] px-3.5 py-2 text-[12.5px] font-bold text-madain-tundora transition hover:border-madain-gold">طيّ الكل</button>
    </div>
  </div>

  {sections.map((s) => (
    <details id={`s-${s.ord}`} class="group mt-4 scroll-mt-24 overflow-hidden rounded-2xl border border-[#E8E2D4] bg-white shadow-sm">
      <summary class="flex cursor-pointer list-none flex-wrap items-center gap-3 p-5 transition hover:bg-[#FDFBF5] md:p-6">
        <span class="rounded-lg bg-[#0B2545] px-3 py-1.5 text-[14px] font-bold text-white">{s.ord}</span>
        <h2 class="flex-1 text-[16px] font-bold leading-snug text-madain-shaft md:text-[18px]">{s.title}</h2>
        {s.item && (
          <span class="font-inter rounded-md border border-madain-gold px-2 py-0.5 text-[12px] font-bold text-madain-goldDark" dir="ltr">{s.item}</span>
        )}
        <svg class="shrink-0 text-madain-gold transition group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </summary>

      <div class="space-y-4 border-t border-[#F1EADB] p-5 md:p-6">
        {s.blocks.map((b) => (
          <>
            {b.t === 'p' && (
              <p class="text-[13.5px] leading-loose text-madain-tundora">{b.text}</p>
            )}

            {b.t === 'sub' && (
              <h3 class="flex items-baseline gap-2.5 pt-3 text-[15px] font-bold text-madain-shaft">
                <span class="font-inter shrink-0 rounded-md border border-madain-gold px-2 py-0.5 text-[12px] text-madain-goldDark" dir="ltr">
                  {b.n}
                </span>
                {b.title}
              </h3>
            )}

            {b.t === 'head' && (
              <h3 class="pt-3 text-[15px] font-bold text-madain-shaft">{b.text}</h3>
            )}

            {b.t === 'bullet' && (
              <p class="pr-2 text-[13.5px] leading-loose text-madain-tundora">{b.text}</p>
            )}

            {b.t === 'table' && (
              <div class="overflow-hidden rounded-xl border border-[#E8E2D4]">
                <table class="w-full text-right text-[13.5px]">
                  <thead>
                    <tr class="bg-[#FBF8F1] text-madain-shaft">
                      {b.rows[0].map((c) => <th class="px-4 py-3 font-bold">{c}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {b.rows.slice(1).map((r, i) => (
                      <tr class={i === b.rows.length - 2 ? 'bg-[#0B2545] text-white' : 'border-t border-[#F1EADB] text-madain-tundora'}>
                        {r.map((c, j) => (
                          <td class={`px-4 py-3 ${j === 1 ? 'font-inter font-bold' : ''} ${i === b.rows.length - 2 ? 'text-[15px]' : ''}`} dir={j === 1 ? 'ltr' : undefined} style={j === 1 ? 'text-align:right' : undefined}>
                            {c}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </>
        ))}
      </div>
    </details>
  ))}

  <!-- Access to the documents -->
  <section class="mt-9 rounded-2xl border border-[#E8E2D4] bg-[#FBF8F1] p-6 shadow-sm md:p-8">
    <h2 class="text-[17px] font-bold text-madain-shaft">{accessTitle}</h2>
    <p class="mt-3 text-[13.5px] leading-loose text-madain-tundora">{accessBody}</p>
  </section>

  <!-- The disclaimer, where the document itself places it -->
  <aside class="mt-6 rounded-2xl border-r-4 border-madain-gold bg-white p-5 shadow-sm md:p-6">
    <p class="text-[13.5px] leading-loose text-madain-tundora">{disclaimer}</p>
  </aside>

  <p class="mt-8 text-center text-[14px] font-bold text-madain-shaft">{footer}</p>

  <div class="mt-6 flex justify-center">
    <button
      type="button"
      onclick="window.print()"
      class="inline-flex items-center gap-2 rounded-lg border border-madain-gold px-5 py-2.5 text-[13.5px] font-bold text-madain-goldDark transition hover:bg-[#FDF9F0] print:hidden"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" rx="1" />
      </svg>
      طباعة العرض
    </button>
  </div>

  <script is:inline>
    (function () {
      var boxes = function () { return document.querySelectorAll('details'); };
      document.querySelectorAll('[data-all]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var open = btn.dataset.all === 'open';
          boxes().forEach(function (d) { d.open = open; });
        });
      });
      // A jump link must open the section it lands on.
      document.querySelectorAll('a[href^="#s-"]').forEach(function (a) {
        a.addEventListener('click', function () {
          var el = document.querySelector(a.getAttribute('href'));
          if (!el) return;
          el.open = true;
          setTimeout(function () { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 0);
        });
      });
      // Printing carries the whole briefing, never only what happens to be open.
      window.addEventListener('beforeprint', function () { boxes().forEach(function (d) { d.open = true; }); });
    })();
  </script>
</AgmLayout>
