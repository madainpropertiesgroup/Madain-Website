---
import AgmLayout from '../../layouts/AgmLayout.astro';

const cards = [
  {
    title: 'الحضور',
    text: 'يمكن للمساهمين الحضور شخصياً أو عن بُعد عبر تقنية الاتصال المرئي.',
    icon: 'people',
  },
  {
    title: 'التسجيل والتحقق',
    text: 'التسجيل يبدأ من الساعة 9:00 صباحاً. يرجى إحضار هوية سارية الصلاحية.',
    icon: 'id',
  },
  {
    title: 'آلية DFM',
    text: 'تسجيل الحضور والتصويت يتم من خلال نظام شركة دبي للمقاصة (DFM).',
    icon: 'dfm',
  },
  {
    title: 'التصويت الإلكتروني',
    text: 'يتم التصويت إلكترونياً أثناء انعقاد الاجتماع بعد استعراض البنود.',
    icon: 'check',
  },
  {
    title: 'التوكيلات',
    text: 'يمكن للمساهم تفويض شخص آخر لتمثيله وفق الشروط والمتطلبات.',
    icon: 'doc',
  },
  {
    title: 'تنويه مهم',
    text: 'التصويت يكون أثناء الاجتماع فقط، ولا يوجد تصويت مسبق خارج الاجتماع.',
    icon: 'info',
  },
];
---

<AgmLayout title="الحضور والتسجيل والتصويت والتوكيلات | الجمعية العمومية 2026" active="attendance">
  <header class="text-center">
    <h1 class="text-[24px] font-bold text-madain-goldDark md:text-[30px]">الحضور والتسجيل والتصويت والتوكيلات</h1>
    <p class="mt-2 text-[15px] text-madain-boulder">تعليمات وإجراءات الجمعية العمومية</p>
    <div class="mx-auto mt-4 h-px w-24 bg-madain-gold/50"></div>
  </header>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map((card) => (
      <article class="rounded-xl border border-[#E8E2D4] bg-white p-6 text-center shadow-sm">
        <div class="flex justify-center">
          {card.icon === 'people' && (
            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9.5" cy="7" r="3.2" />
              <path d="M22 20v-2a4 4 0 0 0-3-3.87M16.5 4.2a3.2 3.2 0 0 1 0 5.6" />
            </svg>
          )}
          {card.icon === 'id' && (
            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="4.5" width="19" height="15" rx="2" /><circle cx="8.5" cy="10.5" r="2.2" />
              <path d="M5 16.2a3.8 3.8 0 0 1 7 0M14 9.5h5M14 13h5" />
            </svg>
          )}
          {card.icon === 'dfm' && (
            <span class="flex h-[42px] items-center justify-center rounded-full border-[1.6px] border-madain-gold px-4 font-inter text-[15px] font-bold tracking-wide text-madain-goldDark">
              DFM
            </span>
          )}
          {card.icon === 'check' && (
            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="3" /><path d="M7.5 12.4l3 3 6-6.6" />
            </svg>
          )}
          {card.icon === 'doc' && (
            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" />
              <path d="M8.5 12.5h7M8.5 16h4.5" />
            </svg>
          )}
          {card.icon === 'info' && (
            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" /><path d="M12 11v5.5" /><circle cx="12" cy="7.8" r=".9" fill="#9C8830" stroke="none" />
            </svg>
          )}
        </div>
        <h2 class="mt-4 text-[17px] font-bold text-madain-shaft">{card.title}</h2>
        <p class="mx-auto mt-2 max-w-[34ch] text-[14px] text-madain-boulder">{card.text}</p>
      </article>
    ))}
  </div>

  <section class="mt-8 rounded-xl border border-[#E8E2D4] bg-[#FBF9F4] p-7 text-center shadow-sm">
    <div class="flex justify-center">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
        <rect x="2.5" y="13.5" width="4" height="6.5" rx="1.6" /><rect x="17.5" y="13.5" width="4" height="6.5" rx="1.6" />
        <path d="M19.5 20v.6a2.4 2.4 0 0 1-2.4 2.4H13" />
      </svg>
    </div>
    <h2 class="mt-3 text-[18px] font-bold text-madain-shaft">للمساعدة والاستفسارات</h2>
    <p class="mx-auto mt-2 max-w-[52ch] text-[14px] text-madain-boulder">
      فريق دعم الجمعية العمومية متاح للإجابة عن استفساراتكم قبل وأثناء الاجتماع.
    </p>
    <a
      href="mailto:investor.relations@madain.ae"
      class="mt-5 inline-block rounded-md bg-madain-gold px-8 py-2.5 text-[14px] font-medium text-white transition hover:bg-madain-goldDark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-madain-goldDark"
    >
      تواصل معنا
    </a>
  </section>
</AgmLayout>
