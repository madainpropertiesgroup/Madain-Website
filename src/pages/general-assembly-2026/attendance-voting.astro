---
import AgmLayout from '../../layouts/AgmLayout.astro';
import VerbatimNote from '../../components/VerbatimNote.astro';
import VenueCard from '../../components/VenueCard.astro';
import Clause from '../../components/Clause.astro';
import { meeting, NOTICE_PDF, PROXY_PDF_AR, PROXY_PDF_EN } from '../../data/agm.js';
import { notes } from '../../data/notice.js';

const pick = (...ns) => ns.map((n) => notes.find((c) => c.n === n)).filter(Boolean);

const groups = [
  { n: '1', title: 'الحضور والتسجيل والنصاب', clauses: pick('3.2', '3.3', '3.1') },
  { n: '2', title: 'التوكيلات وتمثيل الأشخاص الاعتبارية', clauses: pick('3.9', '3.10', '3.11', '3.6') },
  { n: '3', title: 'التصويت', clauses: pick('3.7', '3.8', '3.12', '3.13') },
  { n: '4', title: 'سجل المساهمين وجمع الأصوات', clauses: pick('3.4', '3.5') },
  { n: '5', title: 'المستندات وتحديث البيانات', clauses: pick('3.14', '3.15') },
];
---

<AgmLayout title="الحضور والتسجيل والتصويت | الجمعية العمومية 2026" active="attendance">
  <header class="text-center">
    <h1 class="text-[24px] font-bold text-madain-shaft md:text-[30px]">الحضور والتسجيل والتوكيلات والتصويت</h1>
    <p class="font-inter mt-1 text-[12.5px] font-semibold uppercase tracking-[0.14em] text-madain-gold">
      Attendance, Proxies &amp; Voting
    </p>
    <p class="mt-3 text-[14.5px] font-bold text-madain-shaft">
      {meeting.full} &nbsp;|&nbsp; الساعة {meeting.time}
    </p>
    <div class="mx-auto mt-4 h-px w-24 bg-madain-gold/50"></div>
  </header>

  <VerbatimNote href={NOTICE_PDF} />

  <div class="mt-6"><VenueCard /></div>

  <!-- Key deadlines -->
  <section class="mt-6 grid gap-3 sm:grid-cols-3">
    <article class="rounded-xl border border-[#E8E2D4] bg-white p-5 text-center shadow-sm">
      <div class="text-[12.5px] text-madain-boulder">بدء التسجيل</div>
      <div class="mt-1.5 text-[16px] font-bold text-madain-goldDark">{meeting.registration}</div>
    </article>
    <article class="rounded-xl border border-[#E8E2D4] bg-white p-5 text-center shadow-sm">
      <div class="text-[12.5px] text-madain-boulder">الموعد الأقصى لتقديم التوكيلات</div>
      <div class="mt-1.5 text-[16px] font-bold text-madain-goldDark">27 أكتوبر 2026</div>
      <div class="mt-1 text-[12.5px] text-madain-boulder">إلى سوق دبي المالي / مركز دبي للإيداع</div>
    </article>
    <article class="rounded-xl border border-[#E8E2D4] bg-white p-5 text-center shadow-sm">
      <div class="text-[12.5px] text-madain-boulder">الاجتماع الثاني عند عدم اكتمال النصاب</div>
      <div class="mt-1.5 text-[16px] font-bold text-madain-goldDark">{meeting.secondMeeting}</div>
    </article>
  </section>

  <!-- Proxy forms -->
  <section class="mt-6 rounded-2xl border border-madain-gold/50 bg-[#FDF9F0] p-6 shadow-sm md:p-7">
    <h2 class="text-[18px] font-bold text-madain-shaft">نموذج التوكيل</h2>
    <p class="mt-2 max-w-[70ch] text-[13.5px] leading-relaxed text-madain-tundora">
      يُستوفى النموذج ويُوقّع ويُرفق بمستندات الهوية، ثم يُرسل إلى سوق دبي المالي / مركز دبي للإيداع على البريد
      {' '}<span class="font-inter font-bold text-madain-goldDark" dir="ltr">FinancialServices@dfm.ae</span>
      {' '}في موعد أقصاه <b>{meeting.proxyDeadline}</b>.
    </p>
    <div class="mt-5 flex flex-col gap-3 sm:flex-row">
      <a
        href={PROXY_PDF_AR}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center rounded-md bg-[#0B2545] px-7 py-3 text-[14px] font-bold text-white transition hover:bg-[#153a67]"
      >
        تحميل نموذج التوكيل — عربي
      </a>
      <a
        href={PROXY_PDF_EN}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center rounded-md border-2 border-madain-gold px-7 py-3 text-[14px] font-bold text-madain-goldDark transition hover:bg-[#FDF9F0]"
      >
        Proxy Form &mdash; English
      </a>
    </div>
  </section>

  {groups.map((group) => (
    <section class="mt-6 rounded-2xl border border-madain-gold/35 bg-white p-6 shadow-sm md:p-8">
      <div class="flex items-center gap-3">
        <span class="font-inter flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-madain-gold text-[14px] font-bold text-white">
          {group.n}
        </span>
        <h2 class="text-[19px] font-bold text-madain-shaft">{group.title}</h2>
      </div>
      <div class="mt-5 space-y-3">
        {group.clauses.map((c) => <Clause n={c.n} title={c.title}>{c.text}</Clause>)}
      </div>
    </section>
  ))}
</AgmLayout>
