---
import AgmLayout from '../../layouts/AgmLayout.astro';
import { meeting, contacts } from '../../data/agm.js';

const attendancePoints = [
  'يُعقد الاجتماع بالحضور الشخصي أو بالإنابة حصراً، عملاً بأحكام المادة (40) من النظام الأساسي للشركة.',
  `يبدأ التسجيل في مكان الاجتماع الساعة ${meeting.registration}.`,
  'يتعين على المساهم أو ممثله المفوّض إبراز أصل إثبات الهوية، وأصل سند التوكيل أو التفويض أو نسخته المتحقق منها بحسب الأحوال، وذلك قبل السماح له بالحضور واحتسابه ضمن النصاب.',
  'يُقفل باب التسجيل لحضور الاجتماع عندما يُعلن رئيس الاجتماع اكتمال النصاب أو عدم اكتماله، بعد مضي نصف ساعة من الوقت المحدد في إعلان الدعوة، ولا يُقبل بعد ذلك تسجيل أي مساهم أو نائب عنه، ولا يُعتد بصوته أو برأيه في المسائل التي تُطرح فيه.',
  'يتولى سوق دبي المالي / مركز دبي للإيداع، بصفته أمين سجل أسهم الشركة، مسك سجل المساهمين وتلقي التوكيلات والتحقق منها وتسجيل الحضور وجمع الأصوات وفرزها بالتنسيق مع جامع الأصوات المعيّن ووفقاً للإجراءات المعتمدة من الوزارة.',
  'يُعتمد أحدث سجل للمساهمين صادر عن سوق دبي المالي / مركز دبي للإيداع في تحديد الحضور والتمثيل والنصاب والتصويت، وتثبت حقوق الحضور والتصويت وفق القيد في ذلك السجل في نهاية يوم العمل السابق مباشرةً للاجتماع، ويُحدد الاستحقاق بصورة مستقلة للاجتماع الأول وللاجتماع الثاني إن عُقد.',
];

const proxyPoints = [
  'يجوز للمساهم أن ينيب عنه شخصاً آخر من غير أعضاء مجلس الإدارة بموجب توكيل خاص ثابت بالكتابة.',
  'لا يجوز للوكيل عن عدة مساهمين أن يمثل بهذه الصفة أكثر من خمسة بالمائة (5%) من رأس مال الشركة.',
  'يجوز للمساهم من الأشخاص الاعتبارية تفويض ممثل عنه أو من يعهد إليه بإدارته، وذلك بتقديم قرار مجلس إدارة أو قرار مماثل ساري المفعول أو توكيل حديث الإصدار (لم يمض على إصداره أكثر من سنتين في تاريخ الاجتماع)، ورخصته التجارية السارية، ونموذج التفويض المستوفى، ومستندات صفة المخول بالتوقيع. ويجب تصديق المستندات الصادرة من خارج الدولة حسب الأصول متى كان ذلك مطلوباً.',
  'تُراجع التوكيلات الخاصة وتفويضات الأشخاص الاعتبارية ومستندات الهوية المرفقة بها ويُتحقق منها قبل الاجتماع من قبل أمين سجل الأسهم بالتنسيق مع جامع الأصوات المعيّن.',
  'لا يُقبل أي توكيل أو تفويض غير مستوفٍ أو غير مصدق حسب الأصول أو وارد بعد انتهاء المهلة المحددة، ولا يُسمح لحامله بالحضور بتلك الصفة ولا يُحتسب ضمن النصاب.',
];

const votingPoints = [
  {
    title: 'آلية التصويت في مقر الاجتماع',
    text: 'يجوز أن يتم التصويت باستخدام آلية تصويت إلكترونية تُتاح للحاضرين في مقر الاجتماع، بشرط أن تمكّن المساهم من التصويت بسهولة وبشكل آمن وسري، وأن تحدد لكل مساهم عدد أسهمه وتتيح له توزيع أصواته على القرارات. ولا تُجيز هذه الآلية الحضور أو التصويت من خارج مقر الاجتماع.',
  },
  {
    title: 'التصويت بنداً بنداً',
    text: 'يكون التصويت على كل بند من بنود جدول الأعمال على حدة وخلال فترة زمنية كافية، ولا يُعاد فتح التصويت على بند بعد الانتقال إلى البند التالي، وتُمكّن الآلية المساهم من تسجيل اعتراضه كتابةً، وتُحفظ نتائج التصويت والاعتراضات في سجل إلكتروني لدى الشركة.',
  },
  {
    title: 'انتخاب أعضاء المجلس — التصويت السري التراكمي',
    text: 'يتم انتخاب أعضاء مجلس الإدارة بطريقة التصويت السري التراكمي وفقاً للنظام الأساسي وأحكام قانون الشركات التجارية. ويكون لكل مساهم عدد من الأصوات مساوٍ لعدد أسهمه، وله أن يمنحها لمرشح واحد أو أن يوزعها بين أكثر من مرشح، على ألا يتجاوز مجموع الأصوات الممنوحة عدد أسهمه.',
  },
  {
    title: 'تعارض المصالح وقيود التصويت',
    text: 'لا يجوز لعضو مجلس الإدارة أو أي شخص يكون إبراء ذمته أو منفعته الخاصة أو تعارض مصالحه أو نزاعه مع الشركة محل نظر أن يصوت على القرار المعني، وذلك في الحدود المقررة قانوناً. ويتولى جامع الأصوات تطبيق القيود ذات الصلة وإثباتها وفق مصفوفة التصويت المعتمدة من الوزارة.',
  },
  {
    title: 'حقوق المناقشة',
    text: `لكل مساهم مناقشة الموضوعات المدرجة في جدول الأعمال وتوجيه الأسئلة اللازمة، مع مراعاة ضوابط حسن إدارة الاجتماع. كما يجوز إرسال الأسئلة مسبقاً إلى رئيس مجلس الإدارة على البريد التالي: ${contacts.legal}`,
  },
  {
    title: 'سجل حضور المساهمين',
    text: 'تُراعى أحكام المادة (44) من النظام الأساسي للشركة، ومنها تسجيل المساهمين الراغبين في الحضور أسماءهم في السجل الإلكتروني المعد لهذا الغرض في مكان الاجتماع قبل الوقت المحدد للانعقاد بوقت كافٍ، ومنح المساهم أو النائب عنه بطاقة حضور يُذكر فيها عدد الأصوات التي يمثلها أصالةً أو وكالةً.',
  },
];
---

<AgmLayout title="الحضور والتسجيل والتصويت | الجمعية العمومية 2026" active="attendance">
  <header class="text-center">
    <h1 class="text-[24px] font-bold text-madain-shaft md:text-[30px]">الحضور والتسجيل والتوكيلات والتصويت</h1>
    <p class="font-inter mt-1 text-[12.5px] font-semibold uppercase tracking-[0.14em] text-madain-gold">
      Attendance, Proxies &amp; Voting
    </p>
    <p class="mt-3 text-[14.5px] font-bold text-madain-shaft">
      {meeting.full} &nbsp;|&nbsp; الساعة {meeting.time}
    </p>
    <div class="mx-auto mt-4 h-px w-24 bg-madain-gold/50"></div>
  </header>

  <!-- Venue & timings -->
  <section class="mt-7 rounded-2xl border border-[#E8E2D4] bg-white p-6 shadow-sm md:p-8">
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-madain-gold font-inter text-[14px] font-bold text-white">1</span>
      <h2 class="text-[19px] font-bold text-madain-shaft">مكان الاجتماع ومواعيده</h2>
    </div>

    <div class="mt-5 rounded-xl border border-[#EFEADD] bg-[#FBF9F4] p-5">
      <h3 class="text-[15.5px] font-bold text-madain-shaft">{meeting.venue}</h3>
      <p class="mt-1.5 text-[14px] text-madain-tundora">{meeting.venueDetail}</p>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-[#EFEADD] bg-white p-5 text-center">
        <div class="text-[13px] text-madain-boulder">بدء التسجيل</div>
        <div class="mt-1 text-[18px] font-bold text-madain-goldDark">{meeting.registration}</div>
      </div>
      <div class="rounded-xl border border-[#EFEADD] bg-white p-5 text-center">
        <div class="text-[13px] text-madain-boulder">بدء الاجتماع</div>
        <div class="mt-1 text-[18px] font-bold text-madain-goldDark">{meeting.time}</div>
      </div>
      <div class="rounded-xl border border-[#EFEADD] bg-white p-5 text-center">
        <div class="text-[13px] text-madain-boulder">الاجتماع الثاني</div>
        <div class="mt-1 text-[15px] font-bold text-madain-goldDark">{meeting.secondMeeting}</div>
        <div class="mt-0.5 text-[12.5px] text-madain-boulder">عند عدم اكتمال النصاب</div>
      </div>
    </div>

    <p class="mt-4 rounded-xl border border-madain-gold/40 bg-[#FDF9F0] p-5 text-[13.5px] leading-relaxed text-madain-tundora">
      في حال عدم اكتمال النصاب القانوني اللازم لانعقاد الاجتماع الأول، يُؤجَّل الاجتماع الأول حكماً إلى موعد ثانٍ
      يُعقد يوم {meeting.secondMeeting} في ذات التوقيت والمكان وبذات طريقة الحضور، ويكون الاجتماع الثاني صحيحاً بمن
      حضر أياً كان عدد المساهمين الحاضرين أو نسبة رأس المال الممثلة فيه.
    </p>

    <ul class="mt-5 space-y-3">
      {attendancePoints.map((point) => (
        <li class="flex gap-3 text-[14px] leading-relaxed text-madain-tundora">
          <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-madain-gold"></span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Proxies -->
  <section class="mt-6 rounded-2xl border border-[#E8E2D4] bg-white p-6 shadow-sm md:p-8">
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-madain-gold font-inter text-[14px] font-bold text-white">2</span>
      <h2 class="text-[19px] font-bold text-madain-shaft">التوكيلات وتمثيل الأشخاص الاعتبارية</h2>
    </div>

    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-madain-gold/50 bg-[#FDF9F0] p-5">
        <h3 class="text-[15px] font-bold text-madain-shaft">الموعد النهائي لتقديم التوكيلات</h3>
        <p class="mt-1.5 text-[15px] font-bold text-madain-goldDark">{meeting.proxyDeadline}</p>
      </div>
      <div class="rounded-xl border border-madain-gold/50 bg-[#FDF9F0] p-5">
        <h3 class="text-[15px] font-bold text-madain-shaft">جهة استلام التوكيلات</h3>
        <p class="mt-1.5 text-[14px] text-madain-tundora">سوق دبي المالي / مركز دبي للإيداع</p>
        <span class="font-inter mt-1 block text-[14.5px] font-bold text-madain-goldDark" dir="ltr">{contacts.dfm}</span>
      </div>
    </div>

    <ul class="mt-5 space-y-3">
      {proxyPoints.map((point) => (
        <li class="flex gap-3 text-[14px] leading-relaxed text-madain-tundora">
          <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-madain-gold"></span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Voting -->
  <section class="mt-6 rounded-2xl border border-[#E8E2D4] bg-white p-6 shadow-sm md:p-8">
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-madain-gold font-inter text-[14px] font-bold text-white">3</span>
      <h2 class="text-[19px] font-bold text-madain-shaft">إجراءات التصويت</h2>
    </div>

    <div class="mt-5 grid gap-4 md:grid-cols-2">
      {votingPoints.map((item) => (
        <article class="rounded-xl border border-[#EFEADD] bg-[#FBF9F4] p-5">
          <h3 class="text-[15px] font-bold text-madain-shaft">{item.title}</h3>
          <p class="mt-2 text-[13.5px] leading-relaxed text-madain-tundora">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- KYC -->
  <section class="mt-6 rounded-2xl border border-madain-gold/40 bg-[#FDF9F0] p-6 shadow-sm md:p-7">
    <h2 class="text-[17px] font-bold text-madain-shaft">تحديث بيانات المساهمين</h2>
    <p class="mt-2 text-[14px] leading-relaxed text-madain-tundora">
      على كافة المساهمين الذين لم يُحدّثوا بياناتهم إرسال المعلومات التالية إلى البريد الإلكتروني
      {' '}<span class="font-inter font-bold text-madain-goldDark" dir="ltr">{contacts.dfm}</span>:
      رقم المستثمر (NIN)، الاسم الكامل، البريد الإلكتروني ورقم الهاتف المتحرك، نسخة من الهوية الإماراتية أو جواز
      السفر، ومقطع فيديو سيلفي مباشر للمساهم (Video Selfie).
    </p>
  </section>
</AgmLayout>
