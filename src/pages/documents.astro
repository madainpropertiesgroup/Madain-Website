---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AgmTabs from '../../components/AgmTabs.astro';

const documents = [
  {
    title: "Board of Directors' Report",
    description: "The Board's report on the Company's activities and financial position for the financial year.",
  },
  {
    title: 'Audited Financial Statements',
    description: 'The audited balance sheet and profit and loss account for the financial year.',
  },
  {
    title: "External Auditor's Report",
    description: "The independent auditor's report on the Company's financial statements.",
  },
  {
    title: 'Proxy Attendance Form',
    description: 'The approved form for appointing a proxy to attend and vote at the meeting on your behalf.',
  },
];
---

<Layout
  title="Documents — General Assembly Meeting 2026 — Mada'in Properties"
  description="Documents related to the Annual General Assembly Meeting of Mada'in Real Estate Company PJSC — 02 September 2026."
>
  <Header />
  <main>
    <section class="w-full bg-gold-gradient-v text-white">
      <div class="mx-auto max-w-container px-6 py-14 text-center md:py-16">
        <p class="mb-4 text-sm font-light uppercase tracking-widest2 text-madain-straw">
          Annual General Assembly Meeting — 02 September 2026
        </p>
        <h1 class="text-3xl font-light uppercase leading-tight tracking-wide md:text-4xl">
          Meeting Documents
        </h1>
      </div>
    </section>

    <AgmTabs active="documents" />

    <section class="w-full bg-white">
      <div class="mx-auto max-w-container px-6 py-14">
        <div class="mx-auto max-w-3xl">
          <p class="mb-10 text-center font-light leading-relaxed text-madain-tundora">
            The following documents are made available to shareholders in connection with the
            Annual General Assembly Meeting. For copies or enquiries, please contact
            <a href="mailto:sales@madain.ae" class="text-madain-gold underline underline-offset-4 hover:text-madain-goldDark">sales@madain.ae</a>
            or call <a href="tel:+971800370" class="text-madain-gold underline underline-offset-4 hover:text-madain-goldDark">+971 800 370</a>.
          </p>

          <div class="space-y-5">
            {documents.map((doc) => (
              <div class="flex items-start gap-5 rounded-md border border-madain-gallery bg-white p-6 shadow-sm">
                <span class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-madain-gallery/70 text-madain-gold">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14,2 14,8 20,8" />
                    <line x1="8" y1="13" x2="16" y2="13" />
                    <line x1="8" y1="17" x2="16" y2="17" />
                  </svg>
                </span>
                <div>
                  <h2 class="mb-1 text-lg font-normal text-madain-shaft">{doc.title}</h2>
                  <p class="font-light leading-relaxed text-madain-tundora">{doc.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
