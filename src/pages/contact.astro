---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company.js';

const cards = [
  {
    title: 'Office',
    icon: 'pin',
    lines: company.address,
  },
  {
    title: 'Telephone',
    icon: 'phone',
    lines: company.phones,
    links: company.phones.map((p) => `tel:${p.replace(/\s/g, '')}`),
  },
  {
    title: 'Email',
    icon: 'mail',
    lines: [company.email],
    links: [`mailto:${company.email}`],
  },
  {
    title: 'WhatsApp',
    icon: 'whatsapp',
    lines: [company.whatsapp],
    links: [`https://wa.me/${company.whatsapp.replace(/\D/g, '')}`],
  },
];
---

<Layout title="Contact | Mada'in Properties">
  <Header />
  <main>
    <section class="w-full bg-gold-gradient py-16 text-center text-white lg:py-20">
      <div class="mx-auto max-w-container px-6">
        <p class="mb-3 text-sm font-light uppercase tracking-widest2 text-white/80">Get in touch</p>
        <h1 class="font-light uppercase tracking-widest2 text-[clamp(26px,3.2vw,40px)]">Contact Us</h1>
      </div>
    </section>

    <section class="mx-auto max-w-container px-6 py-16 lg:py-20">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {cards.map((card) => (
          <article class="flex flex-col items-center rounded-sm bg-white p-8 text-center shadow-sm ring-1 ring-madain-gallery">
            <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-madain-gallery/70">
              {card.icon === 'pin' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8A7A2E" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" /><circle cx="12" cy="10" r="2.4" />
                </svg>
              )}
              {card.icon === 'phone' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8A7A2E" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.94.36 1.86.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.95.34 1.87.57 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              )}
              {card.icon === 'mail' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8A7A2E" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
                </svg>
              )}
              {card.icon === 'whatsapp' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#8A7A2E">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.52 13.99c-.21.58-1.21 1.11-1.68 1.18-.43.06-.96.09-1.55-.1-.36-.12-.81-.27-1.4-.52-2.47-1.06-4.08-3.53-4.2-3.7-.12-.16-1-1.33-1-2.54s.64-1.81.86-2.05c.22-.25.49-.31.65-.31h.47c.16.01.36-.5.56.43.21.5.71 1.73.77 1.85.06.13.1.27.02.44-.8.16-.12.26-.25.41-.12.15-.26.33-.37.44-.13.12-.26.25-.11.5.14.25.64 1.06 1.38 1.72.94.84 1.74 1.1 1.99 1.23.25.12.4.1.54-.6.15-.17.63-.73.79-.97.17-.25.33-.21.56-.13.22.09 1.44.69 1.69.81.25.12.41.18.47.29.06.11.06.6-.14 1.18z" />
                </svg>
              )}
            </span>
            <h2 class="mb-3 text-sm font-light uppercase tracking-widest2 text-madain-gold">{card.title}</h2>
            <div class="space-y-1 text-[15px] font-light leading-7 text-madain-tundora">
              {card.lines.map((line, i) => (
                card.links ? (
                  <p><a href={card.links[i]} class="transition hover:text-madain-gold">{line}</a></p>
                ) : (
                  <p>{line}</p>
                )
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class="mt-10 rounded-sm bg-madain-gallery/50 p-8 text-center">
        <h2 class="text-sm font-light uppercase tracking-widest2 text-madain-gold">Working hours</h2>
        <p class="mt-3 text-[15px] font-light text-madain-tundora">{company.hours}</p>
      </div>

      <div class="mt-10 rounded-sm border border-madain-gold/40 bg-[#FDF9F0] p-8 text-center">
        <h2 class="text-sm font-light uppercase tracking-widest2 text-madain-gold">Shareholders</h2>
        <p class="mx-auto mt-3 max-w-[70ch] text-[15px] font-light leading-7 text-madain-tundora">
          For matters concerning the General Assembly meeting of 4 November 2026 &mdash; the notice, the agenda,
          nominations, proxies or attendance &mdash; please see the dedicated section.
        </p>
        <a
          href="/general-assembly-2026/"
          class="mt-6 inline-block rounded-[30px] border border-madain-shaft bg-white px-8 py-3 text-xs font-light uppercase tracking-widest2 text-madain-shaft transition hover:bg-madain-shaft hover:text-white"
        >
          General Assembly 2026
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
