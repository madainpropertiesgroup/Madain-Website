---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AgmTabs from '../../components/AgmTabs.astro';

const agendaItems = [
  {
    title: "Board of Directors' Report",
    detail:
      "Review and approve the Board of Directors' report on the Company's activities and financial position for the financial year.",
  },
  {
    title: "External Auditor's Report",
    detail:
      "Review and approve the external auditor's report for the financial year.",
  },
  {
    title: 'Financial Statements',
    detail:
      "Discuss and approve the Company's balance sheet and profit and loss account for the financial year.",
  },
  {
    title: 'Board Remuneration',
    detail:
      'Consider and approve the proposal regarding the remuneration of the members of the Board of Directors.',
  },
  {
    title: 'Discharge of Liability',
    detail:
      'Consider the discharge of the members of the Board of Directors and the external auditors from liability for the financial year.',
  },
  {
    title: 'Appointment of External Auditors',
    detail:
      'Appoint the external auditors for the upcoming financial year and determine their fees.',
  },
];
---

<Layout
  title="Agenda — General Assembly Meeting 2026 — Mada'in Properties"
  description="Agenda of the Annual General Assembly Meeting of Mada'in Real Estate Company PJSC — Wednesday 02 September 2026."
>
  <Header />
  <main>
    <section class="w-full bg-gold-gradient-v text-white">
      <div class="mx-auto max-w-container px-6 py-14 text-center md:py-16">
        <p class="mb-4 text-sm font-light uppercase tracking-widest2 text-madain-straw">
          Annual General Assembly Meeting — 02 September 2026
        </p>
        <h1 class="text-3xl font-light uppercase leading-tight tracking-wide md:text-4xl">
          Meeting Agenda
        </h1>
      </div>
    </section>

    <AgmTabs active="agenda" />

    <section class="w-full bg-white">
      <div class="mx-auto max-w-container px-6 py-14">
        <div class="mx-auto max-w-3xl">
          <ol class="space-y-6">
            {agendaItems.map((item, i) => (
              <li class="flex gap-5 rounded-md border border-madain-gallery bg-white p-6 shadow-sm">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gold-gradient text-base font-normal text-white">
                  {i + 1}
                </span>
                <div>
                  <h2 class="mb-1 text-lg font-normal text-madain-shaft">{item.title}</h2>
                  <p class="font-light leading-relaxed text-madain-tundora">{item.detail}</p>
                </div>
              </li>
            ))}
          </ol>

          <p class="mt-10 rounded-md bg-madain-gallery/50 p-6 text-sm font-light leading-relaxed text-madain-tundora">
            The agenda items are presented in accordance with the Company's Articles of
            Association and the applicable UAE regulations. Resolutions on the above matters
            are adopted by the majority required by law for each item.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
