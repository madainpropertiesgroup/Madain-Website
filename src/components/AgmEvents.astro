---
// Measurement for the assembly pages. It reads the rendered page rather than
// the source, so editing a page's markup does not silently stop the counting.
// Nothing here identifies a visitor.
---

<script is:inline>
  (function () {
    function send(name, params) {
      if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
    }
    var path = location.pathname;
    var slugOf = function (href) {
      var m = String(href).match(/\/cv\/([a-z0-9-]+)\.pdf|\/nominees\/([a-z0-9-]+)\/?$/i);
      return m ? (m[1] || m[2]) : '';
    };
    document.querySelectorAll('a[href*="/cv/"][href$=".pdf"]').forEach(function (a) {
      a.addEventListener('click', function () {
        send('nominee_cv_open', { nominee: slugOf(a.getAttribute('href')), from_page: path });
      });
    });
    document.querySelectorAll('a[href*="/nominees/"]').forEach(function (a) {
      var slug = slugOf(a.getAttribute('href'));
      if (!slug) return;
      a.addEventListener('click', function () {
        send('nominee_profile_open', { nominee: slug, from_page: path });
      });
    });
    document.querySelectorAll('details[id^="s-"]').forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (!d.open) return;
        var head = d.querySelector('summary h2');
        var item = d.querySelector('summary [dir="ltr"]');
        send('briefing_section_open', {
          section: (d.id || '').replace(/^s-/, ''),
          agenda_item: item ? item.textContent.trim() : '',
          section_title: head ? head.textContent.trim().slice(0, 100) : '',
        });
      });
    });
    document.querySelectorAll('[data-all]').forEach(function (b) {
      b.addEventListener('click', function () {
        send(b.dataset.all === 'open' ? 'briefing_open_all' : 'briefing_collapse_all', {});
      });
    });
    document.querySelectorAll('button[onclick*="print"]').forEach(function (b) {
      b.addEventListener('click', function () { send('briefing_print', { page: path }); });
    });
    var impact = null;
    document.querySelectorAll('table').forEach(function (t) {
      if (/473,363,579/.test(t.textContent)) impact = t;
    });
    if (impact && 'IntersectionObserver' in window) {
      var seen = false;
      new IntersectionObserver(function (entries, obs) {
        if (seen || !entries[0].isIntersecting) return;
        seen = true; send('briefing_reached_impact', {}); obs.disconnect();
      }, { threshold: 0.4 }).observe(impact);
    }
  })();
</script>
