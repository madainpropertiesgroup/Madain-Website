---
// The band that tells a shareholder, before anything else on the page, that
// the date moved. It is the loudest thing on every assembly page until the
// meeting is held: somebody who last read this site in October has 4 November
// in their diary.
//
// It states the fact and sends the reader to the announcement. It quotes no
// figure from the minutes: the document speaks for itself, and a number
// repeated across six pages is six places for it to go wrong.
import { meeting, firstCall } from '../data/agm.js';
import { headline, bandLine } from '../data/postponement.js';

interface Props {
  // On the page that carries the announcement the band drops its link,
  // because the link would point at the page the reader is already on.
  linked?: boolean;
}

const { linked = true } = Astro.props;
---

<section class="overflow-hidden rounded-2xl border border-madain-gold/45 bg-[#FDF6E4] shadow-sm">
  <div class="flex flex-col gap-5 p-5 md:flex-row md:items-center md:gap-7 md:p-6">
    <div class="flex items-start gap-3 md:flex-1">
      <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-madain-gold/15">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#9C8830" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M12 7.5v5l3 2" />
        </svg>
      </span>
      <div>
        <p class="font-inter text-[11px] font-semibold uppercase tracking-[0.16em] text-madain-goldDark">
          Meeting postponed
        </p>
        <h2 class="mt-1 text-[17px] font-bold leading-snug text-[#0B2545] md:text-[19px]">{headline}</h2>
        <p class="mt-2 max-w-[68ch] text-[13.5px] leading-[1.9] text-madain-tundora">{bandLine}</p>
        {linked && (
          <a
            href="/general-assembly-2026/postponement/"
            class="mt-3 inline-flex items-center gap-1.5 text-[13px] font-bold text-madain-goldDark underline underline-offset-4 transition hover:text-[#0B2545]"
          >
            الإعلان ومحضر إثبات عدم اكتمال النصاب
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 18l-6-6 6-6" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- The date that replaces the one people wrote down -->
    <div class="shrink-0 rounded-xl bg-[#0B2545] px-6 py-5 text-center text-white md:min-w-[186px]">
      <div class="text-[12px] text-white/70">الموعد الثاني</div>
      <div class="mt-1.5 text-[13.5px] font-bold text-madain-straw">{meeting.day}</div>
      <div class="font-inter text-[42px] font-extrabold leading-none text-madain-straw">{meeting.date}</div>
      <div class="mt-1 text-[15px] font-bold">{meeting.month} {meeting.year}</div>
      <div class="mt-3 border-t border-white/15 pt-3 text-[13px]">
        الساعة <b class="text-madain-straw">{meeting.time}</b>
      </div>
      <div class="mt-2 text-[12px] text-white/70 line-through decoration-white/40">
        {firstCall.full}
      </div>
    </div>
  </div>
</section>
