---
// Nothing here may leave the site: the old madain.com pages have no way back,
// so labels we no longer host are plain words rather than links.
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about-us/' },
  { label: 'Projects' },
  { label: 'Contact', href: '/contact/' },
];

const norm = (path) => path.replace(/\/+$/, '') || '/';
const here = norm(Astro.url.pathname);
---

<header class="sticky top-0 z-50 w-full">
  <!-- Top gold bar -->
  <div class="w-full border-t-2 border-[#B23A2A] bg-[#8A7A2E] text-white">
    <div class="mx-auto flex max-w-container flex-col items-center justify-between gap-3 px-6 py-3 md:flex-row">
      <a href="tel:+971800370" class="inline-flex items-center gap-2 text-sm font-light transition hover:text-madain-straw">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        +971 800 370
      </a>

      <a
        href="/general-assembly-2026/"
        class="inline-block bg-[#9C8A3A] px-8 py-3 text-sm font-light uppercase tracking-[0.15em] text-white shadow-inner transition hover:bg-[#78682A]"
      >
        General Assembly 2026
      </a>
    </div>
  </div>

  <!-- White bar with wordmark + nav -->
  <div class="w-full bg-white shadow-sm">
    <div class="mx-auto flex max-w-container items-center justify-between gap-6 px-6 py-5">
      <a href="/" class="flex items-center">
        <img src="/images/logo.png" alt="Mada'in" class="h-10 w-auto md:h-12" />
      </a>

      <nav class="hidden items-center gap-10 lg:flex">
        {navItems.map((item) => (
          item.href ? (
            <a
              href={item.href}
              class:list={[
                'text-base font-light text-[#0B1B3B] transition-colors hover:text-madain-gold',
                here === norm(item.href) && 'border-b border-[#0B1B3B] pb-1',
              ]}
            >
              {item.label}
            </a>
          ) : (
            <span class="cursor-default select-none text-base font-light text-[#0B1B3B]/45">{item.label}</span>
          )
        ))}
      </nav>

      <a href="/contact/" class="text-[#0B1B3B] lg:hidden" aria-label="Contact">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.94.36 1.86.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.95.34 1.87.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
      </a>
    </div>
  </div>
</header>
