---
const BASE = 'https://madain.com';

const navItems = [
  { label: 'Home', href: `${BASE}/`, active: true },
  { label: 'About Us', href: `${BASE}/about-us/` },
  {
    label: 'Projects',
    href: `${BASE}/projects/`,
    badge: 'New',
    children: [
      { label: 'Completed', href: `${BASE}/completed-projects/` },
      { label: 'Upcoming', href: `${BASE}/upcoming-projects/` },
      { label: 'Investment', href: `${BASE}/investment/` },
    ],
  },
  { label: 'Contact', href: `${BASE}/contact-us/` },
];
---

<header class="sticky top-0 z-50 w-full">
  <!-- Top gold bar -->
  <div class="w-full border-t-2 border-[#B23A2A] bg-[#8A7A2E] text-white">
    <div class="mx-auto flex max-w-container flex-col items-center justify-between gap-3 px-6 py-3 md:flex-row">
      <a href="tel:+971800370" class="inline-flex items-center gap-2 text-sm font-light transition hover:text-madain-straw">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        +971 800 370
      </a>

      <a href="mailto:sales@madain.ae" class="inline-flex items-center gap-2 text-sm font-light transition hover:text-madain-straw">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        sales@madain.ae
      </a>

      <a
        href={`${BASE}/book-appointment/`}
        class="inline-block bg-[#9C8A3A] px-8 py-3 text-sm font-light uppercase tracking-[0.15em] text-white shadow-inner transition hover:bg-[#78682A]"
      >
        Book an Appointment
      </a>
    </div>
  </div>

  <!-- White bar with wordmark + nav -->
  <div class="w-full bg-white shadow-sm">
    <div class="mx-auto flex max-w-container items-center justify-between gap-6 px-6 py-5">
      <a href={`${BASE}/`} class="flex items-center">
        <img src="/images/logo.png" alt="Mada'in" class="h-10 w-auto md:h-12" />
      </a>

      <nav class="hidden items-center gap-10 lg:flex">
        {navItems.map((item) => (
          <div class="group relative">
            {item.badge && (
              <span class="pointer-events-none absolute -top-4 left-1/2 -translate-x-1/2 rounded-sm bg-black px-2 py-[2px] text-[10px] font-normal uppercase leading-none text-white">
                {item.badge}
              </span>
            )}
            <a
              href={item.href}
              class:list={[
                'inline-flex items-center gap-1 text-base font-light text-[#0B1B3B] transition-colors hover:text-madain-gold',
                item.active && 'border-b border-[#0B1B3B] pb-1',
              ]}
            >
              {item.label}
              {item.children && (
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="6,9 12,15 18,9" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="pointer-events-none absolute left-1/2 top-full z-50 w-56 -translate-x-1/2 pt-3 opacity-0 transition group-hover:pointer-events-auto group-hover:opacity-100">
                <div class="rounded-md bg-white py-2 shadow-lg ring-1 ring-madain-gallery">
                  {item.children.map((c) => (
                    <a href={c.href} class="block px-4 py-2 text-sm font-light text-[#0B1B3B] transition hover:bg-madain-gallery/50 hover:text-madain-gold">
                      {c.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      <button class="text-[#0B1B3B] lg:hidden" aria-label="Open menu">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>
