---
// Notice that the general assembly has been postponed. Nothing here links to
// the assembly pages any more.
const meeting = {
  day: 'الأربعاء',
  date: '02',
  month: 'سبتمبر',
  year: '2026',
  time: '10:00 صباحاً',
};
---

<section class="w-full bg-[#F3F1EA] py-5 md:py-7">
  <div
    dir="rtl"
    class="mx-auto w-[94%] max-w-[1000px] overflow-hidden rounded-2xl bg-[#FBF6EA] shadow-md ring-1 ring-madain-gold/25"
  >
    <div class="flex flex-col md:flex-row">
      <!-- Announcement -->
      <div class="order-2 flex-1 px-6 py-7 text-center md:order-1 md:px-10 md:py-9">
        <span
          class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[linear-gradient(150deg,#d3aa3b,#9c791b_70%,#7e641d)] shadow-sm"
        >
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1z" />
            <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" />
          </svg>
        </span>

        <div class="mt-4 flex items-center justify-center gap-4">
          <span class="h-px w-16 bg-madain-gold/60 md:w-24"></span>
          <h2 class="text-[26px] font-bold tracking-wide text-[#0B2545] md:text-[32px]">إعلان</h2>
          <span class="h-px w-16 bg-madain-gold/60 md:w-24"></span>
        </div>

        <p class="mx-auto mt-5 max-w-[60ch] text-[14.5px] leading-loose text-madain-tundora md:text-[15.5px]">
          نحيطكم علماً بأنه بناءً على قرار <b class="text-madain-goldDark">وزارة الاقتصاد والسياحة</b> الصادر بتاريخ
          <b class="text-madain-goldDark">1 سبتمبر 2026</b>، تم تأجيل اجتماع الجمعية العمومية لشركة
          <b class="text-[#0B2545]">مدائن العقارية ش.م.خ</b>، المقرر عقده يوم
          <b class="text-madain-goldDark">الأربعاء الموافق 2 سبتمبر 2026 الساعة 10:00 صباحاً</b>، وذلك لإعادة إجراءات
          الدعوة وفقاً لما ورد في قرار الوزارة.
        </p>
      </div>

      <!-- Date of the postponed meeting -->
      <div
        class="order-1 flex items-center justify-center gap-8 bg-[#0B2545] px-6 py-5 text-white md:order-2 md:w-[210px] md:flex-col md:gap-6 md:py-9"
      >
        <div class="flex items-center gap-4 md:flex-col md:gap-3">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#D3AA3B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4.5" width="18" height="16" rx="2" /><path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
            <path d="M7.5 13h2M11 13h2M14.5 13h2M7.5 16.5h2M11 16.5h2" />
          </svg>
          <div class="text-center leading-none">
            <div class="text-[13px] font-bold text-white/85">{meeting.day}</div>
            <div class="font-inter mt-1 text-[38px] font-extrabold leading-none text-madain-straw md:text-[44px]">
              {meeting.date}
            </div>
            <div class="mt-1 text-[15px] font-bold">{meeting.month}</div>
            <div class="font-inter text-[14px] text-white/85">{meeting.year}</div>
          </div>
        </div>

        <span class="h-12 w-px bg-white/25 md:h-px md:w-24"></span>

        <div class="flex items-center gap-4 md:flex-col md:gap-2">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#D3AA3B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" /><path d="M12 7.5V12l3 1.8" />
          </svg>
          <div class="text-center text-[13.5px] leading-tight">
            <span class="block text-white/85">الساعة</span>
            <b>{meeting.time}</b>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact -->
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 bg-[#0B2545] px-5 py-3.5 text-white md:gap-x-14">
      <span class="flex items-center gap-2.5 text-[13px] leading-tight">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#D3AA3B">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.52 13.99c-.21.58-1.21 1.11-1.68 1.18-.43.06-.96.09-1.55-.1-.36-.12-.81-.27-1.4-.52-2.47-1.06-4.08-3.53-4.2-3.7-.12-.16-1-1.33-1-2.54s.64-1.81.86-2.05c.22-.25.49-.31.65-.31h.47c.16.01.36-.5.56.43.21.5.71 1.73.77 1.85.06.13.1.27.02.44-.8.16-.12.26-.25.41-.12.15-.26.33-.37.44-.13.12-.26.25-.11.5.14.25.64 1.06 1.38 1.72.94.84 1.74 1.1 1.99 1.23.25.12.4.1.54-.6.15-.17.63-.73.79-.97.17-.25.33-.21.56-.13.22.09 1.44.69 1.69.81.25.12.41.18.47.29.06.11.06.6-.14 1.18z" />
        </svg>
        <span>
          <span class="block text-white/60">واتساب</span>
          <span class="font-inter font-semibold" dir="ltr">800 370</span>
        </span>
      </span>

      <span class="hidden h-8 w-px bg-white/20 sm:block"></span>

      <span class="font-inter text-[13.5px] font-semibold text-white/90" dir="ltr">madaingrp.ae</span>

      <span class="hidden h-8 w-px bg-white/20 sm:block"></span>

      <span class="flex items-center gap-2.5 text-[13px] leading-tight">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#D3AA3B" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.94.36 1.86.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.95.34 1.87.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <span>
          <span class="block text-white/60">هاتف</span>
          <span class="font-inter font-semibold" dir="ltr">+971 56 477 7666</span>
        </span>
      </span>
    </div>
  </div>
</section>
