---
// General Assembly Meeting — the approved announcement artwork, linked to
// the assembly pages.
const DETAILS_URL = '/general-assembly-2026/';
---

<section class="w-full bg-[#F3F1EA] py-5 md:py-7">
  <div class="mx-auto w-[94%] max-w-[1000px]">
    <a
      href={DETAILS_URL}
      aria-label="اجتماع الجمعية العمومية — الأربعاء 02 سبتمبر 2026، الساعة 10:00 صباحاً — عرض التفاصيل"
      class="block overflow-hidden rounded-xl shadow-md transition hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-madain-gold"
    >
      <img
        src="/images/announcement-banner.png"
        alt="اجتماع الجمعية العمومية لشركة مدائن العقارية ش.م.خ — الأربعاء 02 سبتمبر 2026، الساعة 10:00 صباحاً — واتساب 800 370، هاتف +971 56 477 7666"
        class="block h-auto w-full"
        width="2000"
        height="830"
      />
    </a>
  </div>
</section>
