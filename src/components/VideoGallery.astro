---
const poster = 'https://www.figma.com/api/mcp/asset/5c7f02db-3de1-4d2f-a31d-d39cff076621.png';
---

<section class="w-full bg-gold-gradient-v py-16 lg:py-24 text-white">
  <div class="mx-auto max-w-container px-6">
    <div class="mb-12 text-center">
      <p class="mb-3 text-xs font-light uppercase tracking-widest2 text-white/80">Watch</p>
      <h2 class="font-light uppercase tracking-widest2 text-[clamp(24px,3vw,36px)]">
        Mada'in Square: Virtual Tour
      </h2>
      <div class="mx-auto mt-4 h-[2px] w-16 bg-white/70"></div>
    </div>

    <div class="relative aspect-video w-full overflow-hidden bg-black shadow-2xl">
      <img src={poster} alt="Video preview" class="h-full w-full object-cover opacity-80" />
      <button
        class="absolute inset-0 flex items-center justify-center"
        aria-label="Play video"
      >
        <span class="flex h-20 w-20 items-center justify-center rounded-full bg-white/90 text-madain-shaft transition hover:scale-110">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </button>
    </div>
  </div>
</section>
