---
// Google Analytics 4. Paste the measurement ID between the quotes below
// (it looks like G-4XK92QP7L1); PUBLIC_GA_ID in the build environment works
// too. Nothing is emitted until one of them is set.
const MEASUREMENT_ID = '';

const GA_ID = MEASUREMENT_ID || import.meta.env.PUBLIC_GA_ID || '';

const bootstrap = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA_ID}');
document.addEventListener('click', function (event) {
  var link = event.target.closest && event.target.closest('a[href]');
  if (!link) return;
  var href = link.getAttribute('href') || '';
  if (/\\.pdf(\\?|$)/i.test(href)) {
    gtag('event', 'file_download', {
      file_name: href.split('/').pop(),
      link_url: href,
      page_path: location.pathname
    });
  }
});
`.trim();
---

{
  GA_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
      <script is:inline set:html={bootstrap} />
    </>
  )
}
