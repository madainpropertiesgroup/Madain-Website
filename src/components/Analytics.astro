---
// Google Analytics 4. Set PUBLIC_GA_ID (e.g. G-XXXXXXXXXX) in the build
// environment, or fill it in below. Nothing is emitted until it is set.
const GA_ID = import.meta.env.PUBLIC_GA_ID || '';

const bootstrap = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA_ID}');
document.addEventListener('click', function (event) {
  var link = event.target.closest && event.target.closest('a[href]');
  if (!link) return;
  var href = link.getAttribute('href') || '';
  if (/\\.pdf(\\?|$)/i.test(href)) {
    gtag('event', 'file_download', {
      file_name: href.split('/').pop(),
      link_url: href,
      page_path: location.pathname
    });
  }
});
`.trim();
---

{
  GA_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
      <script is:inline set:html={bootstrap} />
    </>
  )
}
