---
const aboutImg = 'https://www.figma.com/api/mcp/asset/2271a176-280e-4cac-98fd-edd4e49c898c.png';
---

<section class="w-full bg-gold-gradient py-16 lg:py-24">
  <div class="mx-auto grid max-w-container items-center gap-12 px-6 lg:grid-cols-2">
    <div class="text-white">
      <p class="mb-4 text-sm font-light uppercase tracking-widest2 text-white/80">
        About Mada'in Properties
      </p>
      <h2 class="mb-6 font-light uppercase leading-tight tracking-widest2 text-[clamp(24px,3vw,36px)]">
        Mada'in Properties Co<br />(Mada'in) (P.J.S.C)
      </h2>
      <p class="mb-8 text-base font-light leading-7 text-white/95">
        Mada'in Properties PJSC aims to redefine the UAE real estate development landscape
        with unique, boutique properties that surpass all expectations in detail, design
        &ndash; and 5-star experiences.
      </p>
      <a
        href="https://madain.com/about-us/"
        class="inline-block rounded-[30px] border border-madain-shaft bg-white px-8 py-3 text-xs font-light uppercase tracking-widest2 text-madain-shaft transition hover:bg-madain-shaft hover:text-white"
      >
        Read More
      </a>
    </div>
    <div class="relative aspect-[16/9] w-full overflow-hidden rounded-sm shadow-2xl">
      <img
        src={aboutImg}
        alt="Mada'in Properties overview"
        class="h-full w-full object-cover"
      />
    </div>
  </div>
</section>
