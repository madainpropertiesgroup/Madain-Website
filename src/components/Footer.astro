---
import { company } from '../data/company.js';

// Words we no longer host are plain text: the old madain.com pages are a
// one-way door with no route back here.
const columns = [
  { title: 'Projects', items: ['Investment', 'Completed', 'Upcoming'] },
  { title: 'Other Services', items: ['Currency Converter', 'Video Gallery', 'Media Center'] },
  { title: 'Policy', items: ['Privacy Policy', 'Careers', 'Blog'] },
];

const siteLinks = [
  { label: 'About Us', href: '/about-us/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'General Assembly 2026', href: '/general-assembly-2026/' },
];
---

<footer>
  <div class="w-full bg-footer-gradient py-16 text-white lg:py-20">
    <div class="mx-auto grid max-w-container gap-12 px-6 md:grid-cols-4">
      <div>
        <a href="/">
          <img src="/images/site/logo-white.png" alt="Mada'in Properties" class="mb-6 h-14 w-auto" />
        </a>
        <p class="mb-4 text-sm font-light leading-6 text-white/90">
          {company.address.map((line) => <>{line}<br /></>)}
        </p>
        <p class="text-sm font-light leading-6 text-white/90">
          {company.phones.map((phone) => (
            <><a href={`tel:${phone.replace(/\s/g, '')}`} class="hover:text-white">{phone}</a><br /></>
          ))}
          <a href={`mailto:${company.email}`} class="hover:text-white">{company.email}</a>
        </p>
      </div>

      <div>
        <h4 class="mb-6 text-sm font-light uppercase tracking-widest2 text-white">Site</h4>
        <ul class="space-y-3">
          {siteLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm font-light text-white/90 transition hover:text-white">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {columns.slice(0, 2).map((col) => (
        <div>
          <h4 class="mb-6 text-sm font-light uppercase tracking-widest2 text-white">{col.title}</h4>
          <ul class="space-y-3">
            {col.items.map((item) => (
              <li class="text-sm font-light text-white/50">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mx-auto mt-12 max-w-container border-t border-white/20 px-6 pt-6">
      <p class="text-sm font-light text-white/80">{company.hours}</p>
    </div>
  </div>

  <div class="w-full border-t border-madain-abbey bg-white/95 py-4">
    <div class="mx-auto flex max-w-container flex-col items-center justify-between gap-2 px-6 text-xs font-light text-madain-tundora md:flex-row">
      <p>&copy; {new Date().getFullYear()} {company.legalName}. All rights reserved.</p>
      <p class="text-madain-tundora/50">Privacy &nbsp;&middot;&nbsp; Terms &nbsp;&middot;&nbsp; Sitemap</p>
    </div>
  </div>
</footer>
