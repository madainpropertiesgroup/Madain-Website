---
// One verbatim clause of the notice: its number, its heading, its own words.
const { n, title } = Astro.props;
---
<article class="flex gap-4 rounded-xl border border-[#EFEADD] bg-white p-5">
  <span class="font-inter mt-0.5 shrink-0 rounded-md bg-[#0B2545] px-2 py-1 text-[12px] font-bold leading-none text-white" dir="ltr">
    {n}
  </span>
  <div>
    {title && <h3 class="text-[15px] font-bold text-madain-shaft">{title}</h3>}
    <p class={`text-[13.5px] leading-loose text-madain-tundora${title ? ' mt-1.5' : ''}`}>
      <slot />
    </p>
  </div>
</article>
