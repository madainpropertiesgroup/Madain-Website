# ---------------------------------------------------------------------------
# Bulk SMS (scripts/sms/send-bulk.mjs)
# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# ---------------------------------------------------------------------------

# Sender name, as registered with e& and du. Promotional sender IDs must carry
# the AD- prefix required by the TDRA, e.g. AD-MADAIN.
SMS_SENDER=

# Unifonic (default provider) - https://docs.unifonic.com
UNIFONIC_APPSID=

# Taqnyat, for Saudi numbers - https://dev.taqnyat.sa
# TAQNYAT_TOKEN=

# Twilio - https://www.twilio.com/docs/sms  (SMS_SENDER is the +E.164 number)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Any other gateway (4Jawaly, Msegat, ...): copy the shape from its own docs.
# {{to}}, {{text}} and {{sender}} are substituted before the request is sent.
# SMS_CUSTOM_URL=
# SMS_CUSTOM_HEADERS={"Authorization":"Bearer xxx"}
# SMS_CUSTOM_BODY={"numbers":["{{to}}"],"message":"{{text}}","sender":"{{sender}}"}

# Only these numbers can be reached while this is set
# SMS_ALLOWLIST=0501234567
